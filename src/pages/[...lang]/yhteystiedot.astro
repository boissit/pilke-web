---
/**
 * How to reach us: one address, what it is for, and where answers already are.
 *
 * The App Store's support URL points here, and a store reviewer reads it as the
 * promise that a person answers. That is why the page carries the address and not a
 * form: mail to it lands with the owner, and a form would need a backend of its own
 * to mean the same thing.
 *
 * Drawn as one letter on the peach ground rather than the usual head and slabs: the
 * page has a single thing to say, so it says it in a single card. Every topic goes to
 * the same address, so the list says what a message is welcome about and carries no
 * address of its own.
 */
import Icon from '../../components/Icon.astro';
import SparkleScatter from '../../components/SparkleScatter.astro';
import { contactEmail } from '../../data/contact';
import { manualHref } from '../../i18n/manual';
import { localeOf, localePath, localeRoutes, useTranslations } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = () => localeRoutes();

const lang = localeOf(Astro.params);
const t = useTranslations(lang);

// The deletion page's name is a link inside the sentence, so the sentence is cut there.
const account = t('contact.account.body').split('{link}');

// Each topic on the tint of one of the app's card states, so the four read as the
// app's own colours rather than four new ones.
const topics = [
  { icon: 'life-buoy', tint: 'var(--card-sent)', title: t('contact.help.title'), body: t('contact.help.body') },
  { icon: 'lightbulb', tint: 'var(--card-feedback)', title: t('contact.feedback.title'), body: t('contact.feedback.body') },
  { icon: 'user-round', tint: 'var(--card-received)', title: t('contact.account.title') },
  { icon: 'newspaper', tint: 'var(--card-confirmed)', title: t('contact.press.title'), body: t('contact.press.body') },
];
---

<Base lang={lang}>
  <section class="slab slab-pale head">
    <div class="wrap section-pad letter-wrap">
      <SparkleScatter
        fill="var(--sparkle-on-peach)"
        sparkles={[
          { size: 140, rotate: 14, right: '4%', top: '10px', only: 'wide' },
          { size: 54, rotate: -24, left: '5%', bottom: '40px', only: 'wide' },
          { size: 60, rotate: 14, right: '10px', top: '6px', only: 'narrow' },
        ]}
      />
      <article class="letter">
        <Icon name="mail" size={40} strokeWidth={1.75} class="stamp" />
        <h1 class="display-mid">{t('contact.title')}</h1>
        <p class="lede">{t('contact.lead')}</p>
        <a class="go coral big" href={`mailto:${contactEmail}`}>
          <Icon name="send" size={22} />{contactEmail}
        </a>

        <hr />

        <div class="cols">
          <ul>
            {
              topics.map((topic) => (
                <li>
                  <span class="dot" style={`background: ${topic.tint}`}>
                    <Icon name={topic.icon} size={20} />
                  </span>
                  <div>
                    <strong>{topic.title}</strong>
                    {topic.body ? (
                      <p>{topic.body}</p>
                    ) : (
                      <p>
                        {account[0]}
                        <a href={localePath(lang, 'tietojen-poisto')}>{t('legal.deletion.title')}</a>
                        {account[1]}
                      </p>
                    )}
                  </div>
                </li>
              ))
            }
          </ul>

          <aside>
            <h2>{t('contact.answers.title')}</h2>
            <p>{t('contact.answers.body')}</p>
            <a class="arrow" href={localePath(lang, 'kysyttya')}>
              {t('nav.questions')}<Icon name="arrow-right" size={18} />
            </a>
            <a class="arrow" href={manualHref(lang)}>
              {t('nav.manual')}<Icon name="arrow-right" size={18} />
            </a>
          </aside>
        </div>
      </article>
    </div>
  </section>
</Base>

<style>
  /* The same gap under the header as every page that opens with `PageHead`. */
  .head {
    padding-top: clamp(4px, 1.52vw - 2px, 16px);
  }

  .letter-wrap {
    display: flex;
    justify-content: center;
  }

  .letter {
    position: relative;
    width: min(100%, 860px);
    padding: clamp(28px, 5vw, 64px);
    background: var(--surface);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-float);
  }

  /* A stamp in the letter's corner: brand coral, tilted as a stamp stuck on by hand. */
  .letter :global(.stamp) {
    position: absolute;
    top: clamp(20px, 4vw, 44px);
    right: clamp(20px, 4vw, 44px);
    color: var(--brand-main);
    transform: rotate(8deg);
  }

  .lede {
    margin-top: var(--pad-normal);
    max-width: 34ch;
    color: var(--text-soft);
    font-size: 1.125rem;
  }

  .big {
    gap: 10px;
    min-height: 60px;
    margin-top: var(--pad-large);
    padding: 0 28px;
    font-size: clamp(1rem, 1vw + 0.8rem, 1.375rem);
    white-space: nowrap;
  }

  /* A phone narrower than the address at full size: the button tightens rather than
     breaking the address, and the stamp gives the title its corner. */
  @media (max-width: 420px) {
    .letter {
      padding: 28px 22px;
    }

    .big {
      padding: 0 20px;
    }

    .letter :global(.stamp) {
      display: none;
    }
  }

  hr {
    margin: clamp(32px, 5vw, 56px) 0;
    border: 0;
    border-top: 2px dashed var(--rule);
  }

  .cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media (min-width: 760px) {
    .cols {
      grid-template-columns: 1.6fr 1fr;
    }
  }

  ul {
    display: grid;
    gap: 18px;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .dot {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--ink);
    border-radius: 50%;
  }

  li p {
    margin-top: 2px;
    color: var(--text-soft);
  }

  aside {
    align-self: start;
    padding: 24px;
    background: var(--ground);
    border-radius: var(--radius-card);
  }

  aside h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
  }

  aside p {
    margin: var(--pad-normal) 0;
    color: var(--text-soft);
  }

  .arrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
    border-top: 1px solid var(--rule);
  }
</style>
