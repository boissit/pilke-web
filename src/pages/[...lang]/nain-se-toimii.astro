---
/**
 * The long explanation, at `nain-se-toimii`.
 *
 * The front page gives the loop in four steps and stops. This page carries what
 * a reader who wants the whole picture needs, in the order somebody meets it: what
 * happens before the first invitation, the venues and the calendar, how candidates
 * are chosen, the invitation and its answer, the sparks that pay for it, the date
 * itself, what happens after it, what happens when plans change, and why there is
 * no chat.
 *
 * Every section but the sparks and the date carries the screen it is about, laid
 * out as a grid of tinted cards in the front page's language by `GridLayout`. The
 * sections, their order and their copy are `components/nain/sections.ts`.
 *
 * WARNING: **Every number on this page is a backend constant.** Five sparks for
 * an invitation, fifteen held at a time, one hour of shared calendar, at least two
 * times offered, a day to answer. The size of a set is deliberately not one of
 * them: what the copy emphasises is that the reader picks who the invitation goes
 * to, not how many faces they are picking from. They are cited in the
 * README, and a marketing page stating a price the product does not charge is
 * worse than a page that stays vague.
 */
import GridLayout from '../../components/nain/GridLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { localeOf, localeRoutes, useTranslations } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = () => localeRoutes();

const lang = localeOf(Astro.params);
const t = useTranslations(lang);
---

<Base lang={lang}>
  <PageHead title={t('detail.title')} lead={t('detail.lead')} />
  <GridLayout lang={lang} />
</Base>
