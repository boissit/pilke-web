---
/**
 * The manual's front page: `/ohje` and `/en/guide`.
 *
 * One list, in the pages' own `order`: each page is one system of the app, and they
 * are in the order somebody learning it meets them, from what Pilke is to what it
 * keeps about you. Numbered, because that order is the point of the list. Until
 * there is a page to put in it, the list is left out and a line says so.
 *
 * An unfinished page is listed, and says so beside its title. The manual is written a
 * page at a time and a list that hid drafts would be empty for most of its life; the
 * page itself carries the full notice.
 */
import PageHead from '../../../components/PageHead.astro';
import { manualHref, manualPages, manualSegment } from '../../../i18n/manual';
import { defaultLang, languages, useTranslations, type Lang } from '../../../i18n/ui';
import Base from '../../../layouts/Base.astro';

export const getStaticPaths = () =>
  (Object.keys(languages) as Lang[]).map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang, manual: manualSegment[lang] },
    props: { lang },
  }));

const { lang } = Astro.props;
const t = useTranslations(lang);

const pages = await manualPages();
---

<Base lang={lang}>
  <PageHead title={t('manual.title')} lead={t('manual.lead')} />

  <section class="slab slab-white">
    <div class="wrap section-pad">
      {pages.length === 0 && <p class="prose">{t('manual.empty')}</p>}

      {
        pages.length > 0 && (
          <ol class="pages">
            {pages.map((page) => (
              <li>
                <a href={manualHref(lang, page.slug)}>{page.text[lang].title}</a>
                {page.entries[lang].data.draft && <span class="tag">{t('manual.draft.tag')}</span>}
                <p>{page.text[lang].lead}</p>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>
</Base>

<style>
  /* A ruled list, as the ledgers on `nain-se-toimii` are: each row a numeral, the
     title that is the link and the page's own lead under it. The numeral hangs in
     its own column so the titles line up down the page. */
  .pages {
    list-style: none;
    padding: 0;
    border-bottom: var(--edge) solid var(--ink);
    counter-reset: page;
  }

  .pages li {
    position: relative;
    padding-block: var(--pad-normal);
    padding-left: 2.75rem;
    border-top: var(--edge) solid var(--ink);
    counter-increment: page;
  }

  .pages li::before {
    content: counter(page);
    position: absolute;
    left: 0;
    top: var(--pad-normal);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .pages a {
    font-weight: 800;
    font-size: 1.125rem;
  }

  .pages p {
    margin-top: var(--pad-small);
    max-width: 60ch;
  }

  /* Dashed, as every unsettled thing on the site is. */
  .tag {
    display: inline-block;
    margin-left: var(--pad-normal);
    padding: 0 var(--pad-small);
    border: var(--border-width) dashed var(--ink);
    border-radius: var(--radius-small);
    background: var(--brand-background);
    font-size: 0.8125rem;
    font-weight: 700;
    vertical-align: 0.15em;
  }
</style>
