---
/**
 * The manual's front page: `/ohje` and `/en/guide`.
 *
 * One list, in the pages' own `order`: each page is one system of the app, and they
 * are in the order somebody learning it meets them, from what Pilke is to what it
 * keeps about you. Numbered, because that order is the point of the list. Until
 * there is a page to put in it, the list is left out and a line says so.
 *
 * An unfinished page is listed, and says so beside its title. The manual is written a
 * page at a time and a list that hid drafts would be empty for most of its life; the
 * page itself carries the full notice.
 */
import PageHead from '../../../components/PageHead.astro';
import { manualHref, manualPages, manualSegment } from '../../../i18n/manual';
import { defaultLang, languages, useTranslations, type Lang } from '../../../i18n/ui';
import Base from '../../../layouts/Base.astro';

export const getStaticPaths = () =>
  (Object.keys(languages) as Lang[]).map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang, manual: manualSegment[lang] },
    props: { lang },
  }));

const { lang } = Astro.props;
const t = useTranslations(lang);

const pages = await manualPages();
---

<Base lang={lang}>
  <PageHead title={t('manual.title')} lead={t('manual.lead')} />

  <section class="slab slab-white">
    <div class="wrap section-pad">
      {pages.length === 0 && <p class="prose">{t('manual.empty')}</p>}

      {
        pages.length > 0 && (
          <ol class="pages">
            {pages.map((page) => (
              <li>
                <a href={manualHref(lang, page.slug)}>{page.text[lang].title}</a>
                {page.entries[lang].data.draft && <span class="tag">{t('manual.draft.tag')}</span>}
                <p>{page.text[lang].lead}</p>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>
</Base>

<style>
  /* One soft card per page of the manual, numbered in a coral disc: the order is
     the point of the list, so the numeral is the first thing on each card and the
     titles line up beside it down the page. The whole card is not the link — the
     title is — so a reader selecting the lead does not follow it by accident. */
  .pages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    counter-reset: page;
  }

  .pages li {
    position: relative;
    padding: 20px 22px 20px 76px;
    background: var(--ground);
    border-radius: var(--radius-card);
    counter-increment: page;
  }

  .pages li::before {
    content: counter(page);
    position: absolute;
    left: 20px;
    top: 18px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--brand-main);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
  }

  .pages a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1875rem, 0.29vw + 1.12rem, 1.375rem);
    line-height: 1.5;
  }

  .pages p {
    margin-top: 2px;
    max-width: 60ch;
    color: var(--text-soft);
  }

  .tag {
    margin-left: var(--pad-normal);
    vertical-align: 0.2em;
  }

  /* On a phone this is a card inside a card, so both give back some of their side
     room to the text. */
  @media (max-width: 39.99rem) {
    .pages li {
      padding: 18px 16px 18px 62px;
    }

    .pages li::before {
      left: 12px;
    }
  }
</style>
