---
/**
 * The questions, at `kysyttya`.
 *
 * A page rather than a band at the foot of the front page. Somebody arrives with
 * one question and wants an answer to it, which is a different visit from reading
 * the front page top to bottom, and a stack of answers is the last thing a reader
 * of the front page needs before the waitlist.
 *
 * Several answers state numbers the backend owns, through `{{…}}` tokens. Read
 * `README.md` before changing one.
 */
import PageHead from '../../components/PageHead.astro';
import { localeOf, localePath, localeRoutes, useTranslations } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = () => localeRoutes();

const lang = localeOf(Astro.params);
const t = useTranslations(lang);

// The questions in the order the page shows them, the owner's (`kysyttya.yaml`).
const ORDER = ['cost', 'chat', 'matching', 'safety', 'who', 'location', 'cancel', 'noshow', 'timeout', 'ban', 'delete', 'where', 'sparks', 'nomatches', 'feedback', 'again', 'strangers'];

/** An answer cut into text and links: `[text](route)` links to that page of the site. */
const parts = (answer: string) =>
  answer.split(/(\[[^\]]+\]\([^)]+\))/).map((piece) => {
    const link = piece.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
    return link ? { text: link[1], href: localePath(lang, link[2]) } : { text: piece };
  });

const faq = ORDER.map((id) => ({ q: t(`faq.${id}.q`), a: parts(t(`faq.${id}.a`)) }));
---

<Base lang={lang}>
  <PageHead title={t('faq.title')} lead={t('faq.lead')} />

  <section class="slab slab-white">
    <div class="wrap section-pad">
      <dl class="faq">
        {
          faq.map((item) => (
            <div class="qa">
              <dt>{item.q}</dt>
              <dd class="prose">{item.a.map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}</dd>
            </div>
          ))
        }
      </dl>

      <p class="back">
        <a class="go" href={localePath(lang, 'yhteystiedot')}>{t('faq.more')}</a>
        <a class="go ghost" href={localePath(lang)}>{t('nav.back')}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* One soft card per answer, as the front page draws each of its claims: a reader
     scanning for their question reads the bold lines down the cards. */
  .faq {
    margin: 0;
    max-width: 52rem;
    display: grid;
    gap: 12px;
  }

  .qa {
    padding: clamp(20px, 1.5vw + 14px, 28px);
    background: var(--ground);
    border-radius: var(--radius-card);
  }

  dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.25rem, 0.38vw + 1.16rem, 1.5rem);
    line-height: 1.2;
  }

  dd {
    margin: var(--pad-normal) 0 0;
    font-size: 1.0625rem;
  }

  .back {
    margin-top: clamp(2rem, 5vw, 3rem);
  }
</style>
