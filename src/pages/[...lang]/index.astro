---
/**
 * The front page, in the Pehmeä direction: rounded cards on a blush page, the phone
 * on a coral disc, and the app's own card tints carrying the loop.
 *
 * The order is the argument, and it runs: what Pilke is, the three things to
 * remember of it, how a date comes about in four steps, what the currency is, and
 * that meeting a stranger through it is looked after.
 *
 * One page at every width. The 1440 artboard and the 390 artboard are the two ends
 * of it, and every size in between is a straight line from one to the other; where
 * a layout changes rather than scales — the hero's phone moving under the copy, the
 * steps going from two columns to one — it changes at one of three lines, 40rem,
 * 64rem and 75rem, so the page has three shapes and not a dozen.
 *
 * The waitlist is not on this page. It is the footer, in `SiteFooter.astro`, so that
 * a reader who came to `turvallisuus` can join from where they are; the hero's button
 * and the header's are anchors down to it.
 *
 * The currency is here in two lines and no more: what a petal is, the two ways it is
 * earned week to week, and a link to `nain-se-toimii` for the whole ledger. A full
 * price list reads as a game to be played, which is the opposite of what this is.
 */
import { grounds, shots } from '../../assets/screens';
import PetalScatter from '../../components/PetalScatter.astro';
import Phone from '../../components/Phone.astro';
import RoseMark from '../../components/RoseMark.astro';
import { localeOf, localePath, localeRoutes, useTranslations } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = () => localeRoutes();

const lang = localeOf(Astro.params);
const t = useTranslations(lang);

/*
  Each icon is a line drawing in the page's ink, one stroke weight and one 24-unit
  box for all three, on a disc of one of the app's card tints: blue under the paper
  plane, because blue is an invitation you sent. The currency's icon is a rose in
  outline, as the app's own tab bar draws it: a lone petal in outline read as a
  leaf or a heart, and the rose's red silhouette read as a blot beside two lines.
*/
const facts = [
  { title: t('fact.one.title'), body: t('fact.one.body'), tint: 'var(--card-sent)', icon: 'send' },
  { title: t('fact.two.title'), body: t('fact.two.body'), tint: 'var(--card-feedback)', icon: 'calendar' },
  { title: t('fact.three.title'), body: t('fact.three.body'), tint: 'var(--card-received)', icon: 'rose' },
];

/*
  The four steps, each on the tint the app gives that stage of a date: an invitation
  you sent is blue, one you received pink, a confirmed date peach and the feedback
  after it yellow. The tilt alternates so the four phones do not read as a stamped row.
*/
const steps = [
  { title: t('how.one.title'), body: t('how.one.body'), shot: shots.platter, ground: grounds.platter, alt: t('shot.platter'), tint: 'var(--card-sent)' },
  { title: t('how.two.title'), body: t('how.two.body'), shot: shots.invitation, ground: grounds.invitation, alt: t('shot.invitation'), tint: 'var(--card-received)' },
  { title: t('how.three.title'), body: t('how.three.body'), shot: shots.date, ground: grounds.date, alt: t('shot.date'), tint: 'var(--card-confirmed)' },
  { title: t('how.four.title'), body: t('how.four.body'), shot: shots.feedback, ground: grounds.feedback, alt: t('shot.feedback'), tint: 'var(--card-feedback)' },
];

const earnings = [
  { amount: t('petals.calendar.amount'), what: t('detail.earn.calendar'), note: t('petals.calendar.note') },
  { amount: t('petals.date.amount'), what: t('detail.earn.date'), note: t('petals.date.note') },
];

/*
  Venues first. A reader who has not used the app yet is best served by knowing where
  they will be sent; the trusted person and the button are one card, because the
  button does nothing until the number is saved.
*/
const safetyCards = [
  { title: t('safety.card.places.title'), body: t('safety.card.places.body'), icon: 'pin' },
  { title: t('safety.card.button.title'), body: t('safety.card.button.body'), icon: 'button' },
];
---

<Base lang={lang}>
  <section class="hero-section">
    <div class="wrap hero">
      <PetalScatter
        fill="var(--petal-on-peach)"
        fold="hero"
        petals={[
          { shape: 'spoon', size: 90, rotate: 24, left: '36%', top: '40px', only: 'wide' },
          { shape: 'curl', size: 120, rotate: -30, left: '40px', bottom: '30px', only: 'wide' },
          { shape: 'comma', size: 70, rotate: 60, left: '41.5%', bottom: '90px', only: 'wide' },
          { shape: 'backroll', size: 80, rotate: 18, right: '40px', top: '30px', only: 'wide' },
          { shape: 'split', size: 60, rotate: -40, right: '40px', bottom: '30px', only: 'wide' },
          { shape: 'spoon', size: 54, rotate: 24, right: '16px', top: '12px', only: 'narrow' },
          { shape: 'comma', size: 48, rotate: 40, right: '16px', bottom: '16px', only: 'narrow' },
        ]}
      />

      <div class="hero-copy">
        <h1>{t('hero.title')}</h1>
        <p class="lede">{t('hero.lead')}</p>
        <!--
          The footer is the form, so the hero points at it rather than carrying a
          second copy. Two forms on a page are two things to wire up and two places
          to disagree about what was submitted.
        -->
        <p class="actions">
          <a class="go" href="#beta">{t('cta.button')}</a>
          <a class="go ghost" href="#how">{t('nav.how')}</a>
        </p>
      </div>

      <!--
        The phone on a coral disc. The disc is the brand's colour at full strength,
        and the one place on the first screen it is: it is what the eye lands on, and
        the screen on it is the app's home, so that is what the eye lands on too.
      -->
      <div class="hero-art">
        <div class="disc" aria-hidden="true"></div>
        <Phone src={shots.treffit} ground={grounds.treffit} alt={t('shot.treffit')} width={310} tilt={4} lifted class="art-phone" />
      </div>
    </div>

    <ul class="wrap facts">
      {
        facts.map((fact) => (
          <li>
            <span class="icon" style={`background:${fact.tint}`} aria-hidden="true">
              {fact.icon === 'send' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13" /><path d="M22 2l-7 20-4-9-9-4 20-7z" /></svg>
              )}
              {fact.icon === 'calendar' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
              )}
              {fact.icon === 'rose' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5.5c2.1.4 4.4 1.4 7 1.4s4.9-1 7-1.4c.7 4.6-1.6 8.3-7 9.2-5.4-.9-7.7-4.6-7-9.2z" /><path d="M8.8 6.4c.8-1.9 1.9-3 3.2-3.6 1.3.6 2.4 1.7 3.2 3.6" /><path d="M12 14.7v6.8" /><path d="M12 18.6c-1.3-1.9-3.3-2.7-5.3-2.4.4 2.1 2.4 3.3 5.3 2.4z" /></svg>
              )}
            </span>
            <div>
              <h2>{fact.title}</h2>
              <p>{fact.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="how" id="how" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="how-title">{t('how.title')}</h2>
        <p>{t('how.lead')}</p>
      </div>

      <!--
        What happens once, before the loop: its own white card above the four steps,
        because it is not one of them. On a white card a white shell vanishes, and
        this screen is peach at the top, so the shell is the mint of the card's own
        label: a colour the phone does not share with either.
      -->
      <div class="start">
        <PetalScatter
          fill="var(--brand-background)"
          petals={[
            { shape: 'fan', size: 110, rotate: -18, right: '440px', bottom: '-20px', only: 'wide' },
            { shape: 'spoon', size: 70, rotate: 30, left: '52%', top: '36px', only: 'wide' },
            { shape: 'curl', size: 70, rotate: -20, right: '18px', top: '22px', only: 'wide' },
            { shape: 'spoon', size: 56, rotate: -28, left: '-10px', bottom: '60px', only: 'narrow' },
          ]}
        />
        <div class="start-copy">
          <p class="tag">{t('how.start.tag')}</p>
          <h3>{t('how.start.title')}</h3>
          <p>{t('how.start.body')}</p>
        </div>
        <div class="start-phone">
          <Phone src={shots.story} ground={grounds.story} alt={t('shot.story')} width={260} tilt={-4} shell="var(--success)" />
        </div>
      </div>

      <!--
        The phones run off the bottom of their cards on purpose: the top of a screen
        is what says which screen it is, and a whole phone in each of four cards made
        them four posters. The card clips its phone; nothing clips the picture inside
        the phone, which is inset on the app's own ground.
      -->
      <ol class="steps">
        {
          steps.map((step, i) => (
            <li style={`background:${step.tint}`}>
              <div class="step-copy">
                <span class="numeral" aria-hidden="true">{i + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
              <div class="step-phone">
                <Phone src={step.shot} ground={step.ground} alt={step.alt} width={230} tilt={i % 2 === 0 ? 3 : -3} />
              </div>
            </li>
          ))
        }
      </ol>

      <div class="loop">
        <p>{t('how.loop')}</p>
        <a class="go ghost" href={localePath(lang, 'nain-se-toimii')}>{t('how.more')}</a>
      </div>
    </div>
  </section>

  <section class="petals-section" aria-labelledby="petals-title">
    <div class="wrap petals-card">
      <div class="rose-panel">
        <PetalScatter
          fill="var(--petal-on-peach)"
          petals={[
            { shape: 'spoon', size: 80, rotate: -24, left: '36px', top: '40px' },
            { shape: 'comma', size: 64, rotate: 40, right: '36px', bottom: '24px', only: 'wide' },
            { shape: 'curl', size: 70, rotate: 20, right: '28px', top: '56px', only: 'wide' },
            { shape: 'backroll', size: 56, rotate: -16, left: '40px', bottom: '28px', only: 'wide' },
            { shape: 'comma', size: 48, rotate: 50, right: '20px', top: '24px', only: 'narrow' },
          ]}
        />
        <!--
          Two petals of five, because two is what a date pays, and a rose part way
          open is the currency's own picture of "on the way to an invitation".
        -->
        <span class="rose" role="img" aria-label={t('petals.rose.alt')}><RoseMark size={330} petals={2} /></span>
        <p>{t('petals.highlight')}</p>
      </div>

      <div class="petals-copy">
        <h2 id="petals-title">{t('petals.title')}</h2>
        <p class="body">{t('petals.body')}</p>
        <h3>{t('petals.earn')}</h3>
        <ul class="earn">
          {
            earnings.map((row) => (
              <li>
                <span class="amount">{row.amount}</span>
                <span class="what">
                  <span class="label">{row.what}</span>
                  <span class="note">{row.note}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <p class="more"><a href={localePath(lang, 'nain-se-toimii')}>{t('petals.more')}</a></p>
      </div>
    </div>
  </section>

  <section class="safety-section" id="safety" aria-labelledby="safety-title">
    <div class="wrap safety">
      <div class="safety-copy">
        <h2 id="safety-title">{t('safety.front.title')}</h2>
        <p class="body">{t('safety.front.lead')}</p>

        <ul class="safety-cards">
          {
            safetyCards.map((card) => (
              <li>
                <span class="icon" aria-hidden="true">
                  {card.icon === 'pin' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
                  )}
                  {card.icon === 'button' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="4" /></svg>
                  )}
                </span>
                <div>
                  <h3>{card.title}</h3>
                  <p>{card.body}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <!--
          Dashed, and under the cards rather than one of them: beside two features
          that ship, a third card reads as a third feature that ships.
        -->
        <div class="future">
          <h3>{t('safety.future.title')}</h3>
          <p>{t('safety.future.body')}</p>
        </div>

        <a class="read" href={localePath(lang, 'turvallisuus')}>{t('safety.more')}</a>
      </div>

      <div class="safety-aside">
        <Phone src={shots.asetukset} ground={grounds.asetukset} alt={t('shot.asetukset')} width={290} tilt={3} class="aside-phone" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ─── Hero ─────────────────────────────────────────────────────────────── */

  .hero-section {
    padding: clamp(12px, 1.14vw + 7.5px, 24px) var(--gutter-tight) 0;
  }

  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px 22px;
    background: var(--brand-background);
    border-radius: clamp(36px, 1.14vw + 31.5px, 48px);
  }

  .hero > :not(.petals) {
    position: relative;
  }

  /* A size container, so the headline can be set in the column's own width: the
     compound in the Finnish headline is the longest word on the site, and a size
     that fits the column is the only one that never overflows it. */
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 0.76vw + 17px, 28px);
    container-type: inline-size;
  }

  /* 13.8cqi because the compound is 7.1em wide in Fredoka: at that size it fits the
     column whole, and only a phone narrower than the artboard's breaks it at its
     soft hyphen. */
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 13.8cqi, 5.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    hyphens: manual;
  }

  .lede {
    max-width: 500px;
    font-size: clamp(1.0625rem, 0.38vw + 0.97rem, 1.3125rem);
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .actions .go {
    min-height: clamp(56px, 0.38vw + 54.5px, 60px);
    padding-inline: 32px;
    font-size: 1.0625rem;
  }

  /*
    The phone on its disc, drawn in fractions of the art box so it is one picture at
    any size. Stacked, the phone takes more of the box than beside the copy — 71% of
    the width rather than 57% — as the phone artboard draws it: there it is the only
    thing across the screen and it can afford to be read.
  */
  .hero-art {
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 322 / 470;
    margin: 8px auto 0;
    container-type: inline-size;
  }

  .disc {
    position: absolute;
    left: 2%;
    top: 17%;
    width: 96%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--brand-main);
  }

  .hero-art :global(.art-phone) {
    --phone-width: 71.4cqi;
    position: absolute;
    left: 14.3%;
    top: 2%;
  }

  @media (min-width: 40rem) {
    .actions {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 12px;
    }
  }

  /* Stacked on a tablet the headline has the card's whole width, and a line of it
     runs under the petal in the top corner. It stops short of the petal instead;
     the size stays the column's, so only where a line breaks changes. */
  @media (min-width: 40rem) and (max-width: 68.99rem) {
    h1 {
      max-width: calc(100% - 56px);
    }
  }

  @media (min-width: 69rem) {
    .hero {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      min-height: 780px;
      padding: 72px;
    }

    .hero-copy {
      flex: 0 1 580px;
    }

    .hero-art {
      flex: 0 0 auto;
      width: clamp(400px, 37.5vw, 540px);
      aspect-ratio: 540 / 636;
      margin: 0;
    }

    .disc {
      left: 3.7%;
      top: 10.7%;
      width: 92.6%;
    }

    .hero-art :global(.art-phone) {
      --phone-width: 57.4cqi;
      left: 21.3%;
      top: 6.6%;
    }
  }

  /* The three facts: white cards under the hero, a column on a phone and a row of
     three once each can hold its title on one or two lines. */
  .facts {
    list-style: none;
    margin-top: 12px;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .facts li {
    display: flex;
    align-items: flex-start;
    gap: clamp(16px, 0.19vw + 15px, 18px);
    padding: clamp(22px, 0.57vw + 20px, 28px);
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .icon {
    display: grid;
    place-items: center;
    width: clamp(44px, 0.38vw + 42.5px, 48px);
    height: clamp(44px, 0.38vw + 42.5px, 48px);
    flex: 0 0 auto;
    border-radius: 50%;
    color: var(--text);
  }

  .icon svg {
    width: clamp(20px, 0.19vw + 19px, 22px);
    height: clamp(20px, 0.19vw + 19px, 22px);
  }

  .facts li > div {
    display: flex;
    flex-direction: column;
    gap: clamp(4px, 0.19vw + 3px, 6px);
  }

  .facts h2 {
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 0.1vw + 1.04rem, 1.125rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .facts p {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text-soft);
  }

  @media (min-width: 64rem) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
      margin-top: 24px;
    }
  }

  /* ─── How it works ─────────────────────────────────────────────────────── */

  .how {
    padding: var(--section-space) var(--gutter);
  }

  .how .wrap {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 0.76vw + 13px, 24px);
  }

  .section-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-bottom: clamp(16px, 1.52vw + 10px, 32px);
    text-align: center;
  }

  .section-head h2 {
    font-size: clamp(2.75rem, 2.29vw + 2.19rem, 4.25rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .section-head p {
    max-width: 560px;
    font-size: clamp(1.0625rem, 0.19vw + 1.02rem, 1.1875rem);
    line-height: 1.55;
    color: var(--text-soft);
  }

  /* A tinted pill for the card's label: the app's confirm green, because this is
     the part everybody does before anything else. */
  .tag {
    align-self: flex-start;
    padding: 6px 13px;
    background: var(--success);
    border-radius: 999px;
    font-size: clamp(0.8125rem, 0.1vw + 0.79rem, 0.875rem);
    font-weight: 700;
  }

  /*
    The start card. Stacked, the phone sits under the copy in a well of fixed height
    and runs off the card's bottom; wide, it stands to the right of the copy and runs
    off the bottom the same way. Either way the card clips it, and the card's height
    comes from its copy and the well, never from the phone.
  */
  .start {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px 24px 0;
    background: var(--surface);
    border-radius: clamp(32px, 0.76vw + 29px, 40px);
    box-shadow: var(--shadow-card);
  }

  .start > :not(.petals) {
    position: relative;
  }

  .start-copy {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 0.19vw + 13px, 16px);
  }

  .start h3,
  .steps h3 {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.015em;
    hyphens: manual;
  }

  .start h3 {
    font-size: clamp(1.875rem, 1.33vw + 1.55rem, 2.75rem);
  }

  .start-copy p:not(.tag) {
    max-width: 560px;
    font-size: clamp(1rem, 0.1vw + 0.98rem, 1.0625rem);
    line-height: 1.6;
  }

  .start-phone {
    position: relative;
    height: 300px;
    margin-top: 12px;
    --phone-width: 220px;
  }

  .start-phone :global(.phone) {
    position: absolute;
    left: 50%;
    top: 0;
    margin-left: calc(var(--phone-width) / -2);
  }

  @media (min-width: 64rem) {
    .start {
      flex-direction: row;
      align-items: center;
      min-height: 400px;
      padding: 56px 64px;
    }

    /* Clear of the phone at every width: the card's padding plus the room from
       the phone's right offset, its 260px and a gap. */
    .start-copy {
      flex: 0 1 560px;
      max-width: calc(100% + 64px - clamp(40px, 8.3vw, 120px) - 292px);
    }

    .start > .start-phone {
      position: absolute;
      right: clamp(40px, 8.3vw, 120px);
      top: 48px;
      height: auto;
      margin: 0;
      --phone-width: 260px;
    }

    .start-phone :global(.phone) {
      position: static;
      margin: 0;
    }
  }

  /*
    The four steps. Stacked cards on a phone, each with its phone in a well under the
    copy; one wide card per row from 40rem, with the phone to the right; two by two
    from 75rem, where the row is wide enough for two of those.
  */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .steps li {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 600px;
    padding: 28px 24px 0;
    border-radius: clamp(32px, 0.76vw + 29px, 40px);
  }

  .step-copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .steps h3 {
