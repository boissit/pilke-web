---
/**
 * The front page, in the Pehmeä direction: rounded cards on a blush page, a hand
 * holding the phone on a coral disc, and the app's own card tints carrying the loop.
 *
 * Two photographs, each a stock photo with a real still of the app set into its
 * phone: the home screen in the hero, cut out of its photograph, and an invitation
 * received in the footer's beta card, which only this page hands a photograph. A
 * still in a photograph goes stale with the app like any other, so
 * `docs/pictures.md` accounts for them. Every other screen here is the app's own
 * still in a `Phone` frame.
 *
 * The order is the argument, and it is the owner's pitch: what the other apps make
 * you do, struck through in a line of steps under the hero, what Pilke does
 * instead, how it goes in practice, and who would be better off elsewhere. Each answers why anybody should care before the next one is
 * asked, so the page reads as one case top to bottom and the waitlist under it is
 * where the case ends.
 *
 * The page says each thing once and points to where it is said in full: the loop to
 * `nain-se-toimii`, the steps to the manual, the rest of the questions to
 * `kysyttya`. Sparks and safety are not here at all: sparks are how an invitation is
 * paid for, which matters once somebody is using the app, and `turvallisuus` is in
 * the header for anybody who asks. A front page that explains everything is a page
 * nobody reads to the end.
 *
 * One page at every width. The 1440 artboard and the 390 artboard are the two ends
 * of it, and every size in between is a straight line from one to the other; where
 * a layout changes rather than scales — the hero's phone moving under the copy, the
 * steps going from one column to two — it changes at one of four lines, 40rem,
 * 64rem, 69rem and 75rem, so the page has a few shapes and not a dozen.
 *
 * The waitlist is not on this page. It is the footer, in `SiteFooter.astro`, so that
 * a reader who came to `turvallisuus` can join from where they are; the hero's button
 * and the header's are anchors down to it.
 */
import { Picture } from 'astro:assets';
import betaEn from '../../assets/photos/beta-invitation-en.jpg';
import betaFi from '../../assets/photos/beta-invitation-fi.jpg';
import heroEn from '../../assets/photos/hero-cutout-en.png';
import heroFi from '../../assets/photos/hero-cutout-fi.png';
import heroPhoneMask from '../../assets/photos/hero-cutout-phone.png';
import { grounds, shotsFor } from '../../assets/screens';
import Icon from '../../components/Icon.astro';
import SparkleScatter from '../../components/SparkleScatter.astro';
import Phone from '../../components/Phone.astro';
import { manualHref } from '../../i18n/manual';
import { localeOf, localePath, localeRoutes, useTranslations } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = () => localeRoutes();

const lang = localeOf(Astro.params);
const shots = shotsFor(lang);
const t = useTranslations(lang);

/*
  Each photograph carries a still of the app, so each is made once per language
  and the page draws the one in its own: the English page shows the English app.
*/
const photos = {
  fi: { hero: heroFi, beta: betaFi },
  en: { hero: heroEn, beta: betaEn },
}[lang];

/*
  What Pilke does, the owner's four points. Each icon is Lucide's, the app's own set,
  in the page's ink at 1.8 of Lucide's 24 units rather than its 2: at 20 to 22px the
  full weight is a shade darker than the text beside it. Each disc is one of the
  app's card tints: blue under the paper plane, because blue is an invitation you
  sent, peach under the calendar because that is a date confirmed, yellow under
  what follows it because yellow is the feedback.
*/
const instead = [
  { title: t('pitch.instead.match.title'), body: t('pitch.instead.match.body'), tint: 'var(--card-received)', icon: 'sliders-horizontal' },
  { title: t('pitch.instead.invite.title'), body: t('pitch.instead.invite.body'), tint: 'var(--card-sent)', icon: 'send' },
  { title: t('pitch.instead.ready.title'), body: t('pitch.instead.ready.body'), tint: 'var(--card-confirmed)', icon: 'calendar-check' },
  { title: t('pitch.instead.after.title'), body: t('pitch.instead.after.body'), tint: 'var(--card-feedback)', icon: 'heart-handshake' },
];

/*
  The other apps' routine, a step at a time, as the lines between the hero and the
  Pilke section strike it through. "Swaippaa" twice, because it comes round again.
*/
const elsewhereSteps = [
  t('pitch.elsewhere.swipe'),
  t('pitch.elsewhere.chat'),
  t('pitch.elsewhere.ghost'),
  t('pitch.elsewhere.swipe'),
  t('pitch.elsewhere.more'),
  t('pitch.elsewhere.maybe'),
];

/*
  The owner's four steps, each on one of the app's four card tints: an invitation
  received is pink, a confirmed date peach and the feedback after it yellow, and
  the account takes the blue, the one left, so the four are the app's whole set.
  The tilt alternates so the four phones do not read as a stamped row.

  The account's screen is the persoonallisuuskysely's first question, because it
  is the one part of signing up that is Pilke's own; a form asking for a name and
  a birthday is every app's.
*/
const steps = [
  { title: t('pitch.practice.one.title'), body: t('pitch.practice.one.body'), shot: shots.story, ground: grounds.story, alt: t('shot.story'), tint: 'var(--card-sent)' },
  { title: t('pitch.practice.two.title'), body: t('pitch.practice.two.body'), shot: shots.invitation, ground: grounds.invitation, alt: t('shot.invitation'), tint: 'var(--card-received)' },
  { title: t('pitch.practice.three.title'), body: t('pitch.practice.three.body'), shot: shots.date, ground: grounds.date, alt: t('shot.date'), tint: 'var(--card-confirmed)' },
  { title: t('pitch.practice.four.title'), body: t('pitch.practice.four.body'), shot: shots.feedback, ground: grounds.feedback, alt: t('shot.feedback'), tint: 'var(--card-feedback)' },
];

/*
  Who would be better off with another app, and which. The owner's own four, with
  the competitors named: the joke is that Pilke says so itself, and it only works
  if the answer is a real app somebody could go and download.
*/
const notFor = [
  { q: t('pitch.notfor.more.q'), a: t('pitch.notfor.more.a') },
  { q: t('pitch.notfor.chat.q'), a: t('pitch.notfor.chat.a') },
  { q: t('pitch.notfor.phone.q'), a: t('pitch.notfor.phone.a') },
  { q: t('pitch.notfor.algorithm.q'), a: t('pitch.notfor.algorithm.a') },
];
---

<Base lang={lang} betaPhoto={{ src: photos.beta, alt: t('photo.beta') }}>
  <section class="hero-section">
    <div class="wrap hero">
      <SparkleScatter
        fill="var(--sparkle-on-peach)"
        fold="hero"
        sparkles={[
          { size: 100, rotate: 14, left: '36%', top: '40px', only: 'wide' },
          { size: 38, rotate: -26, left: 'calc(36% + 116px)', top: '120px', only: 'wide' },
          { size: 132, rotate: -18, left: '40px', bottom: '30px', only: 'wide' },
          { size: 44, rotate: 30, left: '190px', bottom: '130px', only: 'wide' },
          { size: 76, rotate: 36, left: '41.5%', bottom: '90px', only: 'wide' },
          { size: 90, rotate: 10, right: '40px', top: '30px', only: 'wide' },
          { size: 34, rotate: -32, right: '150px', top: '56px', only: 'wide' },
          { size: 66, rotate: -38, right: '40px', bottom: '30px', only: 'wide' },
          { size: 60, rotate: 14, right: '16px', top: '12px', only: 'narrow' },
          { size: 26, rotate: -28, right: '84px', top: '22px', only: 'narrow' },
          { size: 52, rotate: 38, right: '16px', bottom: '16px', only: 'narrow' },
        ]}
      />

      <div class="hero-copy">
        <h1>{t('hero.title')}</h1>
        <p class="lede">{t('pitch.hero.lead')}</p>
        <!--
          The footer is the form, so the hero points at it rather than carrying a
          second copy. Two forms on a page are two things to wire up and two places
          to disagree about what was submitted. The second button is the start of
          the argument, the struck-through steps under the hero.
        -->
        <p class="actions">
          <a class="go" href="#beta">{t('cta.button')}</a>
          <a class="go ghost" href="#miksi">{t('pitch.hero.more')}</a>
        </p>
      </div>

      <!--
        A hand holding the phone, cut out of its photograph and standing on a coral
        disc. The disc is the brand's colour at full strength and the one place on
        the first screen it is; the screen in the hand is the app's home, so that is
        what the eye lands on. The cut-out is transparent, served as AVIF or WebP
        with the PNG as the fallback. `scripts/photos/cutout.py` makes it.

        The disc clips the hand and the arm: they end on its outline, crisp. The
        phone stands out over the disc's edge at its top and right, with the thumb
        and the fingers gripping it. Both are one mask on the one picture, the disc's
        circle and the phone's part (`hero-cutout-phone.png`, the same size: the
        phone's body and the gripping fingers, each by its own contour) added
        together, so the outline is only ever the disc's arc, the phone's edge or a
        finger's, and nothing is drawn twice.

        Drawn 118.9% of the art box's width, most of the overhang the arm running out
        left of the disc, which the disc clips: 642px beside the copy, and at most
        476px stacked; the widths are those at 1x and 2x.
      -->
      <div class="hero-art" style={`--phone-mask: url(${heroPhoneMask.src})`}>
        <div class="disc" aria-hidden="true"></div>
        <Picture
          src={photos.hero}
          formats={['avif', 'webp']}
          alt={t('photo.hero')}
          widths={[480, 642, 960, 1284, 1400]}
          sizes="(min-width: 69rem) 642px, min(106vw, 476px)"
          loading="eager"
          class="hero-cut"
        />
      </div>
    </div>
  </section>

  <!--
    The other apps' routine, struck through, between the hero and the Pilke section:
    the bridge from "finally, a dating app" to what Pilke does instead. No card of
    its own, on the page's ground, so it reads as the passage from one card to the
    next rather than as a section.

    Each step is a `<del>`, which is what struck-through text is, and a hidden
    lead-in says the same to a screen reader, since most of them read `<del>` as
    plain text. The Pilke section's lead, "Pilke hoitaa nämä puolestasi", points
    back at these lines.
  -->
  <section class="elsewhere" id="miksi" aria-labelledby="elsewhere-note">
    <p class="wrap">
      <span class="visually-hidden" id="elsewhere-note">{t('pitch.elsewhere.note')}</span>
      {elsewhereSteps.map((step) => <del>{step}</del>)}
    </p>
  </section>

  <!--
    What Pilke does instead. The heading is the owner's own contrast line, and the
    phone beside the cards is the three candidates a reader picks from, the one
    screen that shows "no swiping" rather than saying it.
  -->
  <section class="slab slab-pale instead" aria-labelledby="instead-title">
    <div class="wrap section-pad">
      <SparkleScatter
        fill="var(--sparkle-on-peach)"
        sparkles={[
          { size: 110, rotate: 16, right: '6%', top: '32px', only: 'wide' },
          { size: 40, rotate: -24, right: 'calc(6% + 130px)', top: '48px', only: 'wide' },
          { size: 56, rotate: 14, right: '14px', top: '14px', only: 'narrow' },
          { size: 24, rotate: -26, right: '80px', top: '22px', only: 'narrow' },
        ]}
      />
      <div class="instead-head">
        <h2 class="display-mid" id="instead-title">{t('pitch.instead.title')}</h2>
        <p class="lede">{t('pitch.instead.lead')}</p>
      </div>

      <div class="instead-body">
        <ul class="instead-cards">
          {
            instead.map((item) => (
              <li>
                <span class="icon" style={`background:${item.tint}`} aria-hidden="true">
                  <Icon name={item.icon} size={22} strokeWidth={1.8} />
                </span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ul>
        <div class="instead-phone">
          <Phone src={shots.platter} ground={grounds.platter} alt={t('shot.platter')} width={260} tilt={3} />
        </div>
      </div>

      <p class="instead-more">
        <a class="go" href={localePath(lang, 'nain-se-toimii')}>{t('pitch.instead.more')}</a>
      </p>
    </div>
  </section>

  <section class="how" id="how" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="how-title">{t('pitch.practice.title')}</h2>
        <p>{t('pitch.practice.lead')}</p>
      </div>

      <!--
        The phones run off the bottom of their cards on purpose: the top of a screen
        is what says which screen it is, and a whole phone in each of four cards made
        them four posters. The card clips its phone; nothing clips the picture inside
        the phone, which is inset on the app's own ground.
      -->
      <ol class="steps">
        {
          steps.map((step, i) => (
            <li style={`background:${step.tint}`}>
              <div class="step-copy">
                <span class="numeral" aria-hidden="true">{i + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
              <div class="step-phone">
                <Phone src={step.shot} ground={step.ground} alt={step.alt} width={230} tilt={i % 2 === 0 ? 3 : -3} />
              </div>
            </li>
          ))
        }
      </ol>

      <p class="how-more">
        <a class="go ghost" href={manualHref(lang)}>{t('pitch.practice.more')}</a>
      </p>
    </div>
  </section>

  <!--
    Who Pilke is not for, last before the waitlist: a reader who has come this far
    and still wants to swipe is told where to, kindly, and everybody else is one
    card from joining. The question is the big line, because it is the reader's own
    doubt in their own words, and the answer under it is said quietly, as a tip.
  -->
  <section class="slab slab-white not-for" aria-labelledby="notfor-title">
    <div class="wrap section-pad">
      <h2 class="display-mid" id="notfor-title">{t('pitch.notfor.title')}</h2>
      <p class="lede">{t('pitch.notfor.lead')}</p>
      <dl class="qas">
        {
          notFor.map((item) => (
            <div class="qa">
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </div>
          ))
        }
      </dl>
      <p class="not-for-more">
        <a class="go" href={localePath(lang, 'kysyttya')}>{t('pitch.notfor.questions')}</a>
        <a class="go ghost" href={localePath(lang, 'yhteystiedot')}>{t('pitch.notfor.contact')}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* ─── Hero ─────────────────────────────────────────────────────────────── */

  .hero-section {
    padding: clamp(12px, 1.14vw + 7.5px, 24px) var(--gutter-tight) 0;
  }

  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px 22px;
    background: var(--brand-background);
    border-radius: clamp(36px, 1.14vw + 31.5px, 48px);
  }

  /* A size container, so the headline can be set in the column's own width: the
     compound in the Finnish headline is the longest word on the site, and a size
     that fits the column is the only one that never overflows it. */
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 0.76vw + 17px, 28px);
    container-type: inline-size;
  }

  /* 13.8cqi because the compound is 7.1em wide in Fredoka: at that size it fits the
     column whole, and only a phone narrower than the artboard's breaks it at its
     soft hyphen. */
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 13.8cqi, 5.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    hyphens: manual;
  }

  .hero .lede {
    max-width: 500px;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .actions .go {
    min-height: clamp(56px, 0.38vw + 54.5px, 60px);
    padding-inline: 32px;
    font-size: 1.0625rem;
  }

  /*
    The hand and phone on the disc, drawn in fractions of the art box so it is one
    picture at any size, the same at every width. The disc is the box's width; the
    cut-out is 118.89% of it, from 22.89% out past the box's left, and the disc's
    centre is 63.52% below the cut-out's reference line, `--cut-top`; the image
    starts 0.65% above that line, room for the phone's silver frame. `scripts/photos/cutout.py` bakes the
    fingers' part of the mask against that same circle, so the numbers move
    together or not at all.

    The mask is the disc's own circle, in the cut-out's coordinates: its centre is
    the disc's centre less the cut-out's offset, and its radius the disc's, half a
    pixel wider at the edge so the hand covers the disc's anti-aliased rim and no
    coral shows between them. Added to it is the phone's body.
  */
  .hero-art {
    position: relative;
    width: min(100%, 400px);
    aspect-ratio: 100 / 124;
    margin: 8px auto 0;
    container-type: inline-size;
    --cut-top: 4cqi;
    --disc-y: calc(var(--cut-top) + 63.52cqi);
  }

  .disc {
    position: absolute;
    left: 0;
    top: var(--disc-y);
    width: 100cqi;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--brand-main);
    transform: translateY(-50%);
  }

  .hero-art :global(.hero-cut) {
    --circle: radial-gradient(
      circle 50cqi at 72.89cqi 64.17cqi,
      #000 50cqi,
      transparent calc(50cqi + 1px)
    );
    position: absolute;
    left: -22.89cqi;
    top: calc(var(--cut-top) - 0.65cqi);
    width: 118.89cqi;
    max-width: none;
    height: auto;
    -webkit-mask-image: var(--circle), var(--phone-mask);
    mask-image: var(--circle), var(--phone-mask);
    -webkit-mask-size: 100% 100%, 100% 100%;
    mask-size: 100% 100%, 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-composite: source-over;
    mask-composite: add;
  }

  @media (min-width: 40rem) {
    .actions {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 12px;
    }
  }

  /* Stacked on a tablet the headline has the card's whole width, and a line of it
     runs under the sparkle in the top corner. It stops short of the sparkle instead;
     the size stays the column's, so only where a line breaks changes. */
  @media (min-width: 40rem) and (max-width: 68.99rem) {
    h1 {
      max-width: calc(100% - 56px);
    }
  }

  @media (min-width: 69rem) {
    .hero {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      min-height: 780px;
      padding: 72px;
    }

    .hero-copy {
      flex: 0 1 580px;
    }

    .hero-art {
      flex: 0 0 auto;
      width: clamp(400px, 37.5vw, 540px);
      aspect-ratio: 540 / 700;
      margin: 0;
      --cut-top: 16.48cqi;
    }
  }

  /* ─── Shared ───────────────────────────────────────────────────────────── */

  /* An icon on a disc, as the app draws one beside a heading: the disc's colour is
     the card's to set, the stroke is the page's ink. */
  .icon {
    display: grid;
    place-items: center;
    width: clamp(44px, 0.38vw + 42.5px, 48px);
    height: clamp(44px, 0.38vw + 42.5px, 48px);
    flex: 0 0 auto;
    border-radius: 50%;
    color: var(--text);
  }

  .icon :global(svg) {
    width: clamp(20px, 0.19vw + 19px, 22px);
    height: clamp(20px, 0.19vw + 19px, 22px);
  }

  /* A card's lines under its icon: the title in the body face at weight, as every
     card label on the site is, and the body a step softer. */
  .instead-cards h3 {
    font-size: clamp(1.125rem, 0.2vw + 1.08rem, 1.25rem);
  }

  .instead-cards p {
    font-size: clamp(0.9375rem, 0.1vw + 0.91rem, 1rem);
    line-height: 1.55;
    color: var(--text-soft);
  }

  /* ─── What Pilke does instead ──────────────────────────────────────────── */

  .instead > .wrap {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 1.5vw + 18px, 40px);
  }

  /* Room on the right for the sparkle in the corner, as `PageHead` leaves it; wide,
     the line breaks in two well short of it. */
  .instead-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: calc(100% - 56px);
  }

  .instead-head h2 {
    max-width: 22ch;
  }

  .instead-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .instead-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    width: 100%;
  }

  .instead-cards li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(22px, 0.57vw + 20px, 28px);
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .instead-cards li .icon {
    margin-bottom: 4px;
  }

  .instead-phone {
    --phone-width: 230px;
  }

  @media (min-width: 40rem) {
    .instead-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  /* Wide, the phone stands to the right of the four cards, as tall as two rows of
     them, so the screen and the claims read as one picture. */
  @media (min-width: 64rem) {
    .instead-body {
      flex-direction: row;
      align-items: center;
      gap: clamp(32px, 3vw, 56px);
    }

    .instead-cards {
      flex: 1;
      gap: 20px;
    }

    .instead-phone {
      flex: 0 0 auto;
      --phone-width: clamp(220px, 19vw, 260px);
    }
  }

  /* ─── The other apps, struck through ───────────────────────────────────── */

  /*
    The lines between the hero and the Pilke section, on the page's own ground. Set
    in the display face at the size of a section head's second rank, left-aligned
    with the cards' content so the eye runs down one edge from the hero's headline
    to the Pilke section's, and with the air of a section break above and below.
    The words wrap freely on a phone; each step keeps its own strike.
  */
  .elsewhere {
    padding: clamp(36px, 3.05vw + 24px, 72px) var(--gutter);
  }

  /* The inline padding is `.section-pad`'s, so the first word stands on the same
     line as the Pilke section's heading under it. */
  .elsewhere > .wrap {
    padding-inline: clamp(22px, 5.52vw + 0.5px, 80px);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 2.67vw + 1.35rem, 3.75rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-soft);
    text-wrap: balance;
  }

  /* The strike is a bar drawn over each step rather than `line-through`, so it can
     be drawn in: a little below the middle of the lowercase, in coral. */
  .elsewhere del {
    position: relative;
    display: inline-block;
    margin-right: 0.3em;
    text-decoration: none;
  }

  .elsewhere del::after {
    content: '';
    position: absolute;
    left: -0.04em;
    right: -0.04em;
    top: 54%;
    height: 0.09em;
    border-radius: 999px;
    background: var(--brand-main);
    transform-origin: left center;
  }

  /* Where the browser can tie an animation to scrolling and the reader has not
     asked for less motion, each strike is drawn as its step comes into view, one
     after the other; everywhere else they are simply there. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .elsewhere del::after {
        animation: strike linear both;
        animation-timeline: view();
