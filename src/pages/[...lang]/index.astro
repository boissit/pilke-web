---
/**
 * The front page, in the Pehmeä direction: rounded cards on a blush page, a hand
 * holding the phone on a coral disc, and the app's own card tints carrying the loop.
 *
 * Four photographs, each a stock photo with a real still of the app set into its
 * phone: the home screen in the hero, cut out of its photograph, the personality quiz
 * on a sofa in the start card, the calendar against an orange wall in the loop card
 * that closes the steps, and an invitation received in the footer's beta card, which
 * only this page hands a photograph. A still in a photograph
 * goes stale with the app like any other, so `docs/pictures.md` accounts for them.
 *
 * The order is the argument, and it runs: what Pilke is, the three things to
 * remember of it, how a date comes about in four steps, what sparks are, and
 * that meeting a stranger through it is looked after.
 *
 * One page at every width. The 1440 artboard and the 390 artboard are the two ends
 * of it, and every size in between is a straight line from one to the other; where
 * a layout changes rather than scales — the hero's phone moving under the copy, the
 * steps going from two columns to one — it changes at one of three lines, 40rem,
 * 64rem and 75rem, so the page has three shapes and not a dozen.
 *
 * The waitlist is not on this page. It is the footer, in `SiteFooter.astro`, so that
 * a reader who came to `turvallisuus` can join from where they are; the hero's button
 * and the header's are anchors down to it.
 *
 * Sparks are here in two lines and no more: what they are for, the two ways they
 * build up week to week, and a link to `nain-se-toimii` for the whole ledger. A full
 * price list reads as a game to be played, which is the opposite of what this is.
 */
import { getImage, Image, Picture } from 'astro:assets';
import betaEn from '../../assets/photos/beta-invitation-en.jpg';
import betaFi from '../../assets/photos/beta-invitation-fi.jpg';
import heroEn from '../../assets/photos/hero-cutout-en.png';
import heroFi from '../../assets/photos/hero-cutout-fi.png';
import heroPhoneMask from '../../assets/photos/hero-cutout-phone.png';
import loopEn from '../../assets/photos/loop-calendar-en.jpg';
import loopFi from '../../assets/photos/loop-calendar-fi.jpg';
import startNarrowEn from '../../assets/photos/start-story-narrow-en.jpg';
import startNarrowFi from '../../assets/photos/start-story-narrow-fi.jpg';
import startWideEn from '../../assets/photos/start-story-wide-en.jpg';
import startWideFi from '../../assets/photos/start-story-wide-fi.jpg';
import { grounds, shotsFor } from '../../assets/screens';
import Icon from '../../components/Icon.astro';
import SparkleScatter from '../../components/SparkleScatter.astro';
import Phone from '../../components/Phone.astro';
import Sparkle from '../../components/Sparkle.astro';
import { localeOf, localePath, localeRoutes, useTranslations } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = () => localeRoutes();

const lang = localeOf(Astro.params);
const shots = shotsFor(lang);
const t = useTranslations(lang);

/*
  Each photograph carries a still of the app, so each is made once per language
  and the page draws the one in its own: the English page shows the English app.
*/
const photos = {
  fi: { hero: heroFi, startWide: startWideFi, startNarrow: startNarrowFi, loop: loopFi, beta: betaFi },
  en: { hero: heroEn, startWide: startWideEn, startNarrow: startNarrowEn, loop: loopEn, beta: betaEn },
}[lang];

/*
  Each icon is Lucide's, the app's own set, in the page's ink at one stroke weight, on
  a disc of one of the app's card tints: blue under the paper plane, because blue is
  an invitation you sent. The stroke is 1.8 of Lucide's 24 units rather than its 2:
  at 20 to 22px the full weight is a shade darker than the text beside it.

  The sparks' icon is `spark`, the logo's own sparkle outlined at Lucide's weight, as
  the app's Treffit tab draws it. Lucide's `sparkle` is a different star, and beside
  the wordmark in the header a second star would read as a second mark.
*/
const facts = [
  { title: t('fact.one.title'), body: t('fact.one.body'), tint: 'var(--card-sent)', icon: 'send' },
  { title: t('fact.two.title'), body: t('fact.two.body'), tint: 'var(--card-feedback)', icon: 'calendar' },
  { title: t('fact.three.title'), body: t('fact.three.body'), tint: 'var(--card-received)', icon: 'spark' },
];

/*
  The four steps, each on the tint the app gives that stage of a date: an invitation
  you sent is blue, one you received pink, a confirmed date peach and the feedback
  after it yellow. The tilt alternates so the four phones do not read as a stamped row.
*/
const steps = [
  { title: t('how.one.title'), body: t('how.one.body'), shot: shots.platter, ground: grounds.platter, alt: t('shot.platter'), tint: 'var(--card-sent)' },
  { title: t('how.two.title'), body: t('how.two.body'), shot: shots.invitation, ground: grounds.invitation, alt: t('shot.invitation'), tint: 'var(--card-received)' },
  { title: t('how.three.title'), body: t('how.three.body'), shot: shots.date, ground: grounds.date, alt: t('shot.date'), tint: 'var(--card-confirmed)' },
  { title: t('how.four.title'), body: t('how.four.body'), shot: shots.feedback, ground: grounds.feedback, alt: t('shot.feedback'), tint: 'var(--card-feedback)' },
];

const earnings = [
  { amount: t('sparks.calendar.amount'), what: t('detail.earn.calendar'), note: t('sparks.calendar.note') },
  { amount: t('sparks.date.amount'), what: t('detail.earn.date'), note: t('sparks.date.note') },
];

/*
  Venues first. A reader who has not used the app yet is best served by knowing where
  they will be sent; the trusted person and the button are one card, because the
  button does nothing until the number is saved.
*/
/*
  The start card's photograph is cut twice. Wide, it fills the card's right side and
  the whole sofa can be in it; stacked, the same width of photo is a strip 300px
  tall, and the phone would be a stamp in it, so the narrow cut is tight on the hands.
*/
const startSources = {
  wide: await getImage({ src: photos.startWide, widths: [700, 1400], format: 'webp' }),
  narrow: await getImage({ src: photos.startNarrow, widths: [450, 900], format: 'webp' }),
};

const safetyCards = [
  { title: t('safety.card.places.title'), body: t('safety.card.places.body'), icon: 'map-pin' },
  { title: t('safety.card.button.title'), body: t('safety.card.button.body'), icon: 'shield' },
];
---

<Base lang={lang} betaPhoto={{ src: photos.beta, alt: t('photo.beta') }}>
  <section class="hero-section">
    <div class="wrap hero">
      <SparkleScatter
        fill="var(--sparkle-on-peach)"
        fold="hero"
        sparkles={[
          { size: 100, rotate: 14, left: '36%', top: '40px', only: 'wide' },
          { size: 38, rotate: -26, left: 'calc(36% + 116px)', top: '120px', only: 'wide' },
          { size: 132, rotate: -18, left: '40px', bottom: '30px', only: 'wide' },
          { size: 44, rotate: 30, left: '190px', bottom: '130px', only: 'wide' },
          { size: 76, rotate: 36, left: '41.5%', bottom: '90px', only: 'wide' },
          { size: 90, rotate: 10, right: '40px', top: '30px', only: 'wide' },
          { size: 34, rotate: -32, right: '150px', top: '56px', only: 'wide' },
          { size: 66, rotate: -38, right: '40px', bottom: '30px', only: 'wide' },
          { size: 60, rotate: 14, right: '16px', top: '12px', only: 'narrow' },
          { size: 26, rotate: -28, right: '84px', top: '22px', only: 'narrow' },
          { size: 52, rotate: 38, right: '16px', bottom: '16px', only: 'narrow' },
        ]}
      />

      <div class="hero-copy">
        <h1>{t('hero.title')}</h1>
        <p class="lede">{t('hero.lead')}</p>
        <!--
          The footer is the form, so the hero points at it rather than carrying a
          second copy. Two forms on a page are two things to wire up and two places
          to disagree about what was submitted.
        -->
        <p class="actions">
          <a class="go" href="#beta">{t('cta.button')}</a>
          <a class="go ghost" href="#how">{t('nav.how')}</a>
        </p>
      </div>

      <!--
        A hand holding the phone, cut out of its photograph and standing on a coral
        disc. The disc is the brand's colour at full strength and the one place on
        the first screen it is; the screen in the hand is the app's home, so that is
        what the eye lands on. The cut-out is transparent, served as AVIF or WebP
        with the PNG as the fallback. `scripts/photos/cutout.py` makes it.

        The disc clips the hand and the arm: they end on its outline, crisp. The
        phone stands out over the disc's edge at its top and right, with the thumb
        and the fingers gripping it. Both are one mask on the one picture, the disc's
        circle and the phone's part (`hero-cutout-phone.png`, the same size: the
        phone's body and the gripping fingers, each by its own contour) added
        together, so the outline is only ever the disc's arc, the phone's edge or a
        finger's, and nothing is drawn twice.

        Drawn 118.9% of the art box's width, most of the overhang the arm running out
        left of the disc, which the disc clips: 642px beside the copy, and at most
        476px stacked; the widths are those at 1x and 2x.
      -->
      <div class="hero-art" style={`--phone-mask: url(${heroPhoneMask.src})`}>
        <div class="disc" aria-hidden="true"></div>
        <Picture
          src={photos.hero}
          formats={['avif', 'webp']}
          alt={t('photo.hero')}
          widths={[480, 642, 960, 1284, 1400]}
          sizes="(min-width: 69rem) 642px, min(106vw, 476px)"
          loading="eager"
          class="hero-cut"
        />
      </div>
    </div>

    <ul class="wrap facts">
      {
        facts.map((fact) => (
          <li>
            <span class="icon" style={`background:${fact.tint}`} aria-hidden="true">
              <Icon name={fact.icon} size={22} strokeWidth={1.8} />
            </span>
            <div>
              <h2>{fact.title}</h2>
              <p>{fact.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="how" id="how" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="how-title">{t('how.title')}</h2>
        <p>{t('how.lead')}</p>
      </div>

      <!--
        What happens once, before the loop: its own white card above the four steps,
        because it is not one of them. The photograph is somebody at home doing it,
        which is where it is done: fourteen questions on the sofa, not at a venue.
      -->
      <div class="start">
        <SparkleScatter
          fill="var(--brand-background)"
          sparkles={[
            { size: 120, rotate: -16, right: '440px', bottom: '-20px', only: 'wide' },
            { size: 40, rotate: 26, right: '580px', bottom: '90px', only: 'wide' },
            { size: 76, rotate: 30, left: '44%', top: '36px', only: 'wide' },
            { size: 62, rotate: -24, left: '-10px', bottom: '60px', only: 'narrow' },
            { size: 24, rotate: 30, left: '58px', bottom: '40px', only: 'narrow' },
          ]}
        />
        <div class="start-copy">
          <p class="tag">{t('how.start.tag')}</p>
          <h3>{t('how.start.title')}</h3>
          <p>{t('how.start.body')}</p>
        </div>
        <picture class="start-photo">
          <source media="(min-width: 64rem)" srcset={startSources.wide.srcSet.attribute} sizes="45vw" />
          <img src={startSources.narrow.src} srcset={startSources.narrow.srcSet.attribute} sizes="100vw" alt={t('photo.start')} width={900} height={755} loading="lazy" decoding="async" />
        </picture>
      </div>

      <!--
        The phones run off the bottom of their cards on purpose: the top of a screen
        is what says which screen it is, and a whole phone in each of four cards made
        them four posters. The card clips its phone; nothing clips the picture inside
        the phone, which is inset on the app's own ground.
      -->
      <ol class="steps">
        {
          steps.map((step, i) => (
            <li style={`background:${step.tint}`}>
              <div class="step-copy">
                <span class="numeral" aria-hidden="true">{i + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
              <div class="step-phone">
                <Phone src={step.shot} ground={step.ground} alt={step.alt} width={230} tilt={i % 2 === 0 ? 3 : -3} />
              </div>
            </li>
          ))
        }
      </ol>

      <!--
        The loop's closing line is about the calendar, so its card carries the
        calendar: in a hand against an orange wall, a landscape photograph that keeps
        its width beside the line, and becomes the card's foot on a phone.
      -->
      <div class="loop">
        <div class="loop-copy">
          <p>{t('how.loop')}</p>
          <a class="go ghost" href={localePath(lang, 'nain-se-toimii')}>{t('how.more')}</a>
        </div>
        <figure class="loop-photo">
          <Image src={photos.loop} alt={t('photo.loop')} widths={[800, 1200, 1800]} sizes="(min-width: 64rem) 760px, 178vw" />
        </figure>
      </div>
    </div>
  </section>

  <section class="sparks-section" aria-labelledby="sparks-title">
    <div class="wrap sparks-card">
      <div class="spark-panel">
        <SparkleScatter
          fill="var(--sparkle-on-peach)"
          sparkles={[
            { size: 90, rotate: -16, left: '36px', top: '40px' },
            { size: 34, rotate: 24, left: '132px', top: '104px', only: 'wide' },
            { size: 70, rotate: 34, right: '36px', bottom: '24px', only: 'wide' },
            { size: 80, rotate: 14, right: '28px', top: '56px', only: 'wide' },
            { size: 30, rotate: -30, right: '120px', top: '40px', only: 'wide' },
            { size: 62, rotate: -12, left: '40px', bottom: '28px', only: 'wide' },
            { size: 26, rotate: 40, left: '124px', bottom: '36px', only: 'wide' },
            { size: 52, rotate: 40, right: '20px', top: '24px', only: 'narrow' },
            { size: 22, rotate: -20, right: '82px', top: '30px', only: 'narrow' },
          ]}
        />
        <!--
          Two sparks, because two is what a date brings, drawn as the app's counter
          draws two: the pale sparkle with its rose core part grown, the counter's own
          picture of "on the way to an invitation".
        -->
        <span class="counter" role="img" aria-label={t('sparks.art.alt')}><Sparkle size={300} count={2} /></span>
        <p>{t('sparks.highlight')}</p>
      </div>

      <div class="sparks-copy">
        <h2 id="sparks-title">{t('sparks.title')}</h2>
        <p class="body">{t('sparks.body')}</p>
        <h3>{t('sparks.earn')}</h3>
        <ul class="earn">
          {
            earnings.map((row) => (
              <li>
                <span class="amount">{row.amount}</span>
                <span class="what">
                  <span class="label">{row.what}</span>
                  <span class="note">{row.note}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <p class="more"><a href={localePath(lang, 'nain-se-toimii')}>{t('sparks.more')}</a></p>
      </div>
    </div>
  </section>

  <section class="safety-section" id="safety" aria-labelledby="safety-title">
    <div class="wrap safety">
      <div class="safety-copy">
        <h2 id="safety-title">{t('safety.front.title')}</h2>
        <p class="body">{t('safety.front.lead')}</p>

        <ul class="safety-cards">
          {
            safetyCards.map((card) => (
              <li>
                <span class="icon" aria-hidden="true">
                  <Icon name={card.icon} size={20} strokeWidth={1.8} />
                </span>
                <div>
                  <h3>{card.title}</h3>
                  <p>{card.body}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <!--
          Dashed, and under the cards rather than one of them: beside two features
          that ship, a third card reads as a third feature that ships.
        -->
        <div class="future">
          <h3>{t('safety.future.title')}</h3>
          <p>{t('safety.future.body')}</p>
        </div>

        <a class="read" href={localePath(lang, 'turvallisuus')}>{t('safety.more')}</a>
      </div>

      <div class="safety-aside">
        <Phone src={shots.asetukset} ground={grounds.asetukset} alt={t('shot.asetukset')} width={290} tilt={3} class="aside-phone" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ─── Hero ─────────────────────────────────────────────────────────────── */

  .hero-section {
    padding: clamp(12px, 1.14vw + 7.5px, 24px) var(--gutter-tight) 0;
  }

  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px 22px;
    background: var(--brand-background);
    border-radius: clamp(36px, 1.14vw + 31.5px, 48px);
  }

  /* A size container, so the headline can be set in the column's own width: the
     compound in the Finnish headline is the longest word on the site, and a size
     that fits the column is the only one that never overflows it. */
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 0.76vw + 17px, 28px);
    container-type: inline-size;
  }

  /* 13.8cqi because the compound is 7.1em wide in Fredoka: at that size it fits the
     column whole, and only a phone narrower than the artboard's breaks it at its
     soft hyphen. */
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 13.8cqi, 5.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    hyphens: manual;
  }

  .lede {
    max-width: 500px;
    font-size: clamp(1.0625rem, 0.38vw + 0.97rem, 1.3125rem);
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .actions .go {
    min-height: clamp(56px, 0.38vw + 54.5px, 60px);
    padding-inline: 32px;
    font-size: 1.0625rem;
  }

  /*
    The hand and phone on the disc, drawn in fractions of the art box so it is one
    picture at any size, the same at every width. The disc is the box's width; the
    cut-out is 118.89% of it, from 22.89% out past the box's left, and the disc's
    centre is 63.52% below the cut-out's reference line, `--cut-top`; the image
    starts 0.65% above that line, room for the phone's silver frame. `scripts/photos/cutout.py` bakes the
    fingers' part of the mask against that same circle, so the numbers move
    together or not at all.

    The mask is the disc's own circle, in the cut-out's coordinates: its centre is
    the disc's centre less the cut-out's offset, and its radius the disc's, half a
    pixel wider at the edge so the hand covers the disc's anti-aliased rim and no
    coral shows between them. Added to it is the phone's body.
  */
  .hero-art {
    position: relative;
    width: min(100%, 400px);
    aspect-ratio: 100 / 124;
    margin: 8px auto 0;
    container-type: inline-size;
    --cut-top: 4cqi;
    --disc-y: calc(var(--cut-top) + 63.52cqi);
  }

  .disc {
    position: absolute;
    left: 0;
    top: var(--disc-y);
    width: 100cqi;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--brand-main);
    transform: translateY(-50%);
  }

  .hero-art :global(.hero-cut) {
    --circle: radial-gradient(
      circle 50cqi at 72.89cqi 64.17cqi,
      #000 50cqi,
      transparent calc(50cqi + 1px)
    );
    position: absolute;
    left: -22.89cqi;
    top: calc(var(--cut-top) - 0.65cqi);
    width: 118.89cqi;
    max-width: none;
    height: auto;
    -webkit-mask-image: var(--circle), var(--phone-mask);
    mask-image: var(--circle), var(--phone-mask);
    -webkit-mask-size: 100% 100%, 100% 100%;
    mask-size: 100% 100%, 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-composite: source-over;
    mask-composite: add;
  }

  @media (min-width: 40rem) {
    .actions {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 12px;
    }
  }

  /* Stacked on a tablet the headline has the card's whole width, and a line of it
     runs under the sparkle in the top corner. It stops short of the sparkle instead;
     the size stays the column's, so only where a line breaks changes. */
  @media (min-width: 40rem) and (max-width: 68.99rem) {
    h1 {
      max-width: calc(100% - 56px);
    }

  }

  @media (min-width: 69rem) {
    .hero {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      min-height: 780px;
      padding: 72px;
    }

    .hero-copy {
      flex: 0 1 580px;
    }

    .hero-art {
      flex: 0 0 auto;
      width: clamp(400px, 37.5vw, 540px);
      aspect-ratio: 540 / 700;
      margin: 0;
      --cut-top: 16.48cqi;
    }
  }

  /* The three facts: white cards under the hero, a column on a phone and a row of
     three once each can hold its title on one or two lines. */
  .facts {
    list-style: none;
    margin-top: 12px;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .facts li {
    display: flex;
    align-items: flex-start;
    gap: clamp(16px, 0.19vw + 15px, 18px);
    padding: clamp(22px, 0.57vw + 20px, 28px);
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .icon {
    display: grid;
    place-items: center;
    width: clamp(44px, 0.38vw + 42.5px, 48px);
    height: clamp(44px, 0.38vw + 42.5px, 48px);
    flex: 0 0 auto;
    border-radius: 50%;
    color: var(--text);
  }

  .icon :global(svg) {
    width: clamp(20px, 0.19vw + 19px, 22px);
    height: clamp(20px, 0.19vw + 19px, 22px);
  }

  .facts li > div {
    display: flex;
    flex-direction: column;
    gap: clamp(4px, 0.19vw + 3px, 6px);
  }

  .facts h2 {
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 0.1vw + 1.04rem, 1.125rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .facts p {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text-soft);
  }

  @media (min-width: 64rem) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
      margin-top: 24px;
    }
  }

  /* ─── How it works ─────────────────────────────────────────────────────── */

  .how {
    padding: var(--section-space) var(--gutter);
  }

  .how .wrap {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 0.76vw + 13px, 24px);
  }

  .section-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-bottom: clamp(16px, 1.52vw + 10px, 32px);
    text-align: center;
  }

  .section-head h2 {
    font-size: clamp(2.75rem, 2.29vw + 2.19rem, 4.25rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .section-head p {
    max-width: 560px;
    font-size: clamp(1.0625rem, 0.19vw + 1.02rem, 1.1875rem);
    line-height: 1.55;
    color: var(--text-soft);
