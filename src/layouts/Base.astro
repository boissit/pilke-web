---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { languages, localePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const other: Lang = lang === 'fi' ? 'en' : 'fi';

/*
  The path this page is on, without its language prefix, so the language link
  points at the same page in the other language rather than at the front page.
  A reader halfway down the safety page who switches to English should still be
  on the safety page.
*/
const route = Astro.url.pathname.replace(/^\/en\/?/, '/').replace(/^\/+/, '').replace(/\/$/, '');

const nav = [
  { href: localePath(lang, 'nain-se-toimii'), label: t('nav.how') },
  { href: localePath(lang, 'turvallisuus'), label: t('nav.safety') },
  { href: `${localePath(lang)}#faq`, label: t('nav.questions') },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <!--
      The sparkle, not the launcher icon. `icon.png` is the app's Android icon and
      is drawn for a rounded mask at 1024px; in a 16px tab it is a yellow smudge.
      An SVG scales to whatever the browser asks for.
    -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      Both languages point at each other so a search engine offers the reader the
      one they asked for, and `x-default` names Finnish because that is the
      product's language rather than a fallback.
    -->
    <link rel="alternate" hreflang="fi" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'fi' ? 'fi_FI' : 'en_GB'} />
  </head>

  <body>
    <a class="skip" href="#main">{t('nav.skip')}</a>

    <header class="site-head">
      <div class="wrap head-inner">
        <a class="brand" href={localePath(lang)} aria-label="Pilke">
          <Logo size={30} />
        </a>

        <nav aria-label={t('meta.title')}>
          <ul class="nav-list">
            {nav.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
            <li>
              <a class="lang" href={localePath(other, route)} lang={other} hreflang={other}>
                {languages[other]}
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-inner">
        <p>{t('footer.beta')}</p>
        <p class="mark">{t('footer.rights')}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--brand-main);
    border: var(--border-width) solid var(--ink);
    border-radius: var(--radius-normal);
    padding: var(--pad-normal);
    z-index: 10;
  }

  .skip:focus {
    left: var(--pad-medium);
    top: var(--pad-medium);
  }

  .site-head {
    background: var(--brand-main);
    border-bottom: var(--border-width) solid var(--ink);
  }

  .head-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--pad-normal);
    padding-block: var(--pad-normal);
  }

  /* `Logo` carries its own geometry, so the anchor only has to not interfere
     with it. */
  .brand {
    display: inline-block;
    text-decoration: none;
    /* The logo's own top padding is part of the app's lockup, so the header
       pulls the block back up rather than growing to accommodate it. */
    margin-block: calc(var(--pad-small) * -1);
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--pad-medium);
    list-style: none;
    padding: 0;
  }

  .nav-list a {
    text-decoration: none;
    font-weight: 700;
  }

  .nav-list a:hover {
    text-decoration: underline;
  }

  /* The language link is the one control on the page, so it looks like one. */
  .lang {
    border: var(--border-width) solid var(--ink);
    border-radius: var(--radius-normal);
    padding: 2px var(--pad-normal);
    background: var(--white);
  }

  .site-foot {
    margin-top: var(--pad-large);
    background: var(--brand-background);
    border-top: var(--border-width) solid var(--ink);
  }

  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--pad-normal);
    padding-block: var(--pad-large);
  }

  .mark {
    font-family: var(--font-display);
  }
</style>
