---
/**
 * The document every page is drawn in: the head, the bar, the waitlist.
 *
 * A page is a run of `.slab` sections and nothing else — the front page draws its
 * own. Everything around them — the two stylesheets, the metadata, the header and
 * the footer that carries the only form on the site — is here, so a new page is its
 * own content and one `<Base>` wrapper.
 */
import '../styles/global.css';
import '../styles/soft.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /**
   * Where the language switch goes. Left out, it is this page in the other language;
   * a page with no twin there — the 404, which is one file for both — names one.
   */
  alternate?: string;
  /** A photograph for the beta card in the footer; see `SiteFooter.astro`. */
  betaPhoto?: { src: ImageMetadata; alt: string };
}

const { lang, alternate, betaPhoto } = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <!--
      The rose, not the launcher icon. `icon.png` is the app's Android icon and
      is drawn for a rounded mask at 1024px; in a 16px tab it is a coral smudge.
      An SVG scales to whatever the browser asks for.
    -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      Both languages point at each other so a search engine offers the reader the
      one they asked for, and `x-default` names Finnish because that is the
      product's language rather than a fallback.
    -->
    <link rel="alternate" hreflang="fi" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'fi' ? 'fi_FI' : 'en_GB'} />
  </head>

  <body>
    <a class="skip" href="#main">{t('nav.skip')}</a>

    <SiteHeader lang={lang} alternate={alternate} />

    <main id="main">
      <slot />
    </main>

    <SiteFooter lang={lang} alternate={alternate} photo={betaPhoto} />
  </body>
</html>

<style>
  /* The last card on a page stands a section's space above the waitlist. */
  main {
    padding-bottom: var(--section-space);
  }

  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 30;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 24px;
    background: var(--text);
    color: var(--ground);
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
  }

  .skip:focus {
    left: var(--pad-medium);
    top: var(--pad-medium);
  }
</style>
