---
import '../styles/global.css';
import Glimmer from '../components/Glimmer.astro';
import Logo from '../components/Logo.astro';
import { languages, localePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const other: Lang = lang === 'fi' ? 'en' : 'fi';

/*
  The path this page is on, without its language prefix, so the language link
  points at the same page in the other language rather than at the front page.
  A reader halfway down the safety page who switches to English should still be
  on the safety page.
*/
const route = Astro.url.pathname.replace(/^\/en\/?/, '/').replace(/^\/+/, '').replace(/\/$/, '');

const nav = [
  { href: localePath(lang, 'nain-se-toimii'), label: t('nav.how') },
  { href: localePath(lang, 'turvallisuus'), label: t('nav.safety') },
  { href: localePath(lang, 'kysyttya'), label: t('nav.questions') },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <!--
      The sparkle, not the launcher icon. `icon.png` is the app's Android icon and
      is drawn for a rounded mask at 1024px; in a 16px tab it is a yellow smudge.
      An SVG scales to whatever the browser asks for.
    -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      Both languages point at each other so a search engine offers the reader the
      one they asked for, and `x-default` names Finnish because that is the
      product's language rather than a fallback.
    -->
    <link rel="alternate" hreflang="fi" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'fi' ? 'fi_FI' : 'en_GB'} />
  </head>

  <body>
    <a class="skip" href="#main">{t('nav.skip')}</a>

    <header class="site-head">
      <div class="wrap head-inner">
        <a class="brand" href={localePath(lang)} aria-label="Pilke">
          <Logo size={30} />
        </a>

        <nav aria-label={t('meta.title')}>
          <ul class="nav-list">
            {nav.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
            <li>
              <a class="lang" href={localePath(other, route)} lang={other} hreflang={other}>
                {languages[other]}
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <!--
      The footer is the waitlist. It carries the only thing the site asks for, so
      it has to be reachable from the safety page and the detail page and not just
      from the foot of the front page; the hero's button is an anchor down to this.

      WARNING: **this form submits nowhere.** It has no `action` and no handler,
      so it is markup and copy waiting for an endpoint, and it must be wired up or
      removed before the site is public. Two things have to be settled first, both
      recorded in `README.md`: where the addresses are stored, and the privacy
      policy this form has to link to before it may collect one.
    -->
    <footer class="site-foot" id="beta">
      <!--
        The same texture the slabs carry, in grey rather than yellow: the footer is
        the one surface here that is not a slab and not brand-coloured, and a
        yellow sparkle field would put it back in the run of them. Faint enough to
        sit under a form without competing with the field it is behind.

        `star` is an rgba literal rather than a token because it needs alpha and
        `--muted` has none. The alpha is low on purpose: at 0.18 the sparkles read
        as a pattern and pulled the eye off the field they sit behind, so this is
        set to shift the ground by about seven values per channel — present, and
        not something a reader looks at.
      -->
      <Glimmer tile={280} background="var(--card-sent)" star="rgba(128, 128, 128, 0.06)" />

      <div class="wrap foot-inner">
        <div class="foot-copy">
          <h2>{t('cta.title')}</h2>
          <p>{t('cta.body')}</p>
        </div>

        <form class="join">
          <label for="beta-email">{t('cta.label')}</label>
          <div class="join-row">
            <input
              id="beta-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder={t('cta.placeholder')}
            />
            <button class="go" type="submit">{t('cta.button')}</button>
          </div>
          <p class="note">{t('cta.note')}</p>
        </form>
      </div>

      <div class="wrap foot-mark">
        <p class="mark">{t('footer.rights')}</p>
        <p class="tagline">{t('hero.title')}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--brand-main);
    border: var(--border-width) solid var(--ink);
    border-radius: var(--radius-normal);
    padding: var(--pad-normal);
    z-index: 10;
  }

  .skip:focus {
    left: var(--pad-medium);
    top: var(--pad-medium);
  }

  .site-head {
    background: var(--brand-main);
    border-bottom: var(--border-width) solid var(--ink);
  }

  .head-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--pad-normal);
    padding-block: var(--pad-normal);
  }

  /* `Logo` carries its own geometry, so the anchor only has to not interfere
     with it. */
  .brand {
    display: inline-block;
    text-decoration: none;
    /* The logo's own top padding is part of the app's lockup, so the header
       pulls the block back up rather than growing to accommodate it. */
    margin-block: calc(var(--pad-small) * -1);
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--pad-medium);
    list-style: none;
    padding: 0;
  }

  .nav-list a {
    text-decoration: none;
    font-weight: 700;
  }

  .nav-list a:hover {
    text-decoration: underline;
  }

  /* The language link is the one control on the page, so it looks like one. */
  .lang {
    border: var(--border-width) solid var(--ink);
    border-radius: var(--radius-normal);
    padding: 2px var(--pad-normal);
    background: var(--white);
  }

  /* No margin and no top border of its own: every section above this one is a
     `.slab`, and a slab already draws a 3px rule along its bottom edge. Adding
     one here put two rules and a gap of pad-large at the foot of every page.

     The one surface on the site that is not yellow. The page above it is a run of
     yellow and off-white slabs, and the block that asks for something should not
     read as one more of them. `--card-sent` is the app's own outgoing-invitation
     tint, so it is a colour the product already uses. */
  .site-foot {
    position: relative;
    isolation: isolate;
    background: var(--card-sent);
  }

  /* The texture is absolutely positioned, so everything over it needs a layer of
     its own — the same arrangement `.slab > .wrap` uses. */
  .site-foot > .wrap {
    position: relative;
    z-index: 1;
  }

  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 3rem);
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .foot-copy {
    flex: 1 1 20rem;
  }

  .foot-copy h2 {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
  }

  .foot-copy p {
    margin-top: var(--pad-medium);
  }

  .join {
    flex: 1 1 22rem;
    max-width: 30rem;
  }

  .join label {
    display: block;
    font-weight: 800;
    font-size: 0.9375rem;
    margin-bottom: var(--pad-small);
  }

  /* The field takes the room and the button keeps its own width, so a long
     button label in either language does not shrink the field it belongs to. */
  .join-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pad-normal);
  }

  /* Drawn as the app draws a field: the same 3px ink edge and radius as a card,
     white ground, and no offset shadow. The button beside it has the shadow, so
     the pair reads as a hole and a raised key rather than as two buttons. */
  .join input {
    flex: 1 1 13rem;
    min-width: 0;
    appearance: none;
    padding: 10px var(--pad-medium);
    background: var(--white);
    color: var(--ink);
    border: 3px solid var(--ink);
    border-radius: var(--radius-normal);
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.4;
  }

  .join input::placeholder {
    color: var(--muted);
  }

  .join input:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  .go {
    flex: 0 0 auto;
    padding: 10px 20px;
    background: var(--brand-main);
    color: var(--ink);
    border: 3px solid var(--ink);
    border-radius: var(--radius-normal);
    font-family: inherit;
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--ink);
    cursor: pointer;
  }

  .go:hover {
    transform: translate(1px, 1px);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .note {
    margin-top: var(--pad-normal);
    font-size: 0.875rem;
    color: var(--ink);
    opacity: 0.75;
  }

  /* The wordmark sits under its own rule so it is not read as part of the form.
     A hairline rather than the 3px the slabs use: this divides two lines of the
     same footer, and at slab weight it read as another section boundary. */
  .foot-mark {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--pad-normal);
    border-top: 1px solid var(--ink);
    padding-block: var(--pad-large);
  }

  .mark {
    font-family: var(--font-display);
  }

  /* The tagline closes the page on the same words the front page opens with. */
  .tagline {
    font-family: var(--font-display);
    text-align: right;
    color: var(--ink);
    opacity: 0.75;
  }
</style>
