---
/**
 * A few large petals scattered behind a card, the way the Pehmeä artboards dress the
 * hero, the rose panel, the waitlist and each subpage's head.
 *
 * Two or three marks and no more, each placed by hand. A tiled field of them read as
 * wallpaper on a rounded card; three petals at different sizes and angles read as the
 * card having petals on it, which is the whole of the effect.
 *
 * The shapes are the app's own, from `petalArtwork.ts`, drawn flat in `fill`. Pass the
 * card's ground a shade deeper — `--petal-on-peach`, `--petal-on-coral` — so the marks
 * sit in the surface rather than on it.
 *
 * The parent positions, clips and isolates: it has to be `position: relative`,
 * `overflow: hidden` and `isolation: isolate`. The overflow cuts a petal set half
 * off an edge at the card's own rounded corner. The isolation makes the card its own
 * stacking context, and the petals sit at the bottom of it, `z-index: -1`: above the
 * card's background and under everything else on it, however that is wrapped. A
 * sibling given its own position no longer needs lifting over them, and one wrapped
 * in `display: contents` no longer slips under them. They never take a click.
 */
import { PETAL_VIEWBOX, petalSilhouette } from './petalArtwork';

interface Placement {
  /** One of the eight silhouettes in `petalArtwork.ts`. */
  shape: string;
  /** The edge of the petal's square box, in px. */
  size: number;
  /** Degrees, clockwise, about the box's centre. */
  rotate: number;
  top?: string;
  right?: string;
  bottom?: string;
  left?: string;
  /**
   * Drawn only where the page is laid out `wide`, or only where it is `narrow`. The
   * phone artboard keeps one petal per card where the desktop has three: at 390
   * wide a second mark lands behind the text it was meant to sit beside, and the
   * one that stays often sits somewhere else to clear the stacked layout.
   */
  only?: 'wide' | 'narrow';
}

interface Props {
  fill: string;
  petals: Placement[];
  /**
   * The width at which `wide` petals replace the `narrow` ones: the line the header
   * folds its links at, unless the card lays itself out side by side somewhere else.
   * The hero stacks its copy over the phone until 69rem, and the side-by-side petals
   * drawn over a stacked hero land in its headline, so it passes `hero`.
   */
  fold?: 'header' | 'hero';
}

const { fill, petals, fold = 'header' } = Astro.props;

const place = ({ top, right, bottom, left, size, rotate }: Placement) =>
  [
    top && `top:${top}`,
    right && `right:${right}`,
    bottom && `bottom:${bottom}`,
    left && `left:${left}`,
    `width:${size}px`,
    `height:${size}px`,
    `transform:rotate(${rotate}deg)`,
  ]
    .filter(Boolean)
    .join(';');
---

<div class:list={['petals', `fold-${fold}`]} aria-hidden="true">
  {
    petals.map((petal) => (
      <svg class:list={[petal.only]} viewBox={`0 0 ${PETAL_VIEWBOX} ${PETAL_VIEWBOX}`} style={place(petal)} focusable="false">
        <path d={petalSilhouette(petal.shape)} fill={fill} />
      </svg>
    ))
  }
</div>

<style>
  .petals {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  svg {
    position: absolute;
    display: block;
  }

  /* The same line the header folds its links at. */
  @media (max-width: 63.99rem) {
    .fold-header .wide {
      display: none;
    }
  }

  @media (min-width: 64rem) {
    .fold-header .narrow {
      display: none;
    }
  }

  /* The line the hero puts its copy beside the phone at. */
  @media (max-width: 68.99rem) {
    .fold-hero .wide {
      display: none;
    }
  }

  @media (min-width: 69rem) {
    .fold-hero .narrow {
      display: none;
    }
  }
</style>
