---
/**
 * The currency's mark: the brand sparkle struck on a coin.
 *
 * A port of `pilke-app/src/components/svgs/Token.tsx`, drawing the same shape from
 * the same geometry. Two things about it are decisions rather than arithmetic, and
 * they are that file's:
 *
 * The sparkle on its own is the wordmark, which `Logo.astro` draws — a bare one
 * beside a number would ask the reader to tell a logo from a denomination by
 * context alone. The disc is what makes it money: a round face with the 3px ink
 * rule everything else on this site carries.
 *
 * The sparkle inside it is solid ink rather than the wordmark's yellow-on-outline,
 * which is what tells the two apart and is also what lets one drawing run from a
 * price chip to the app's spend screen: a stroke scales with the shape and closes
 * over its own fill at the small end, where a silhouette has none to lose.
 */
import { sparkleShape } from './sparkleShape';

interface Props {
  /** Diameter of the coin, in px. Everything inside is a fraction of it. */
  size?: number;
  class?: string;
}

const { size = 42, class: className } = Astro.props;

/** How much of the coin's diameter the sparkle stands in, from the app. */
const SPARKLE_FRACTION = 0.62;

/**
 * The widest rule the coin can carry, as a fraction of its diameter, from the app.
 *
 * The 3px rule this site draws everything else with closes over the yellow on a
 * small coin: the ring and the ink sparkle inside it meet, and the mark reads as a
 * dark disc. The cap binds below 42px and nowhere else.
 */
const RULE_MAX_FRACTION = 1 / 14;

/** The square the sparkle stands in, in the sparkle's own units. */
const box = sparkleShape.height / SPARKLE_FRACTION;

// In the sparkle's units, so that the rule lands at the px width above.
const strokeWidth = (Math.min(3, size * RULE_MAX_FRACTION) * box) / size;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox={`${-(box - sparkleShape.width) / 2} ${-(box - sparkleShape.height) / 2} ${box} ${box}`}
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle
    cx={sparkleShape.width / 2}
    cy={sparkleShape.height / 2}
    r={(box - strokeWidth) / 2}
    fill="var(--brand-main)"
    stroke="var(--ink)"
    stroke-width={strokeWidth}
  />
  <path d={sparkleShape.path} fill="var(--ink)" />
</svg>
