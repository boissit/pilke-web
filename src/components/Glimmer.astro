---
/**
 * A tileable field of sparkles, behind whatever is placed over it.
 *
 * The six placements are the app's own, from `Glimmer.tsx`, given there as
 * fractions of the tile. Three properties of that arrangement are load-bearing
 * and are the reason for not inventing a new one: a wide range of sizes, a
 * distinct rotation for each sparkle, and no two sharing a row or a column. A
 * regular tile reads as a grid, which looks worse than no texture at all.
 *
 * Every sparkle sits wholly inside the tile, or the repeat draws a lattice of
 * chopped sparkles along the seams.
 */
import { sparkleShape } from './sparkleShape';

interface Props {
  tile?: number;
  background?: string;
  star?: string;
  class?: string;
}

const {
  tile = 320,
  background = 'var(--brand-background)',
  star = '#FCF3AE',
  class: className,
} = Astro.props;

// Fractions of the tile, from pilke-app/src/components/svgs/Glimmer.tsx.
const sparkles = [
  { x: 0.22, y: 0.2, size: 0.34, rotate: -9 },
  { x: 0.61, y: 0.47, size: 0.26, rotate: 31 },
  { x: 0.88, y: 0.79, size: 0.17, rotate: -25 },
  { x: 0.36, y: 0.71, size: 0.13, rotate: 70 },
  { x: 0.77, y: 0.11, size: 0.1, rotate: -52 },
  { x: 0.07, y: 0.55, size: 0.08, rotate: 15 },
];

const { width: shapeWidth, height: shapeHeight, path } = sparkleShape;

const id = `glimmer-${tile}`;
---

<svg class={className} aria-hidden="true" focusable="false" preserveAspectRatio="none">
  <defs>
    <pattern id={id} patternUnits="userSpaceOnUse" width={tile} height={tile}>
      <rect width={tile} height={tile} fill={background} />
      {
        sparkles.map((s) => {
          const w = s.size * tile;
          const scale = w / shapeWidth;
          const x = s.x * tile - w / 2;
          const y = s.y * tile - (shapeHeight * scale) / 2;
          const cx = w / 2;
          const cy = (shapeHeight * scale) / 2;
          return (
            <g transform={`translate(${x} ${y}) rotate(${s.rotate} ${cx} ${cy}) scale(${scale})`}>
              <path d={path} fill={star} />
            </g>
          );
        })
      }
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>

<style>
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
