---
/**
 * The footer is the waitlist. It carries the only thing the site asks for, so it
 * has to be reachable from the safety page and the detail page and not just from
 * the foot of the front page; the hero's button is an anchor down to this.
 *
 * The form posts straight to PostStack's hosted signup form — a public,
 * unauthenticated endpoint — so this static site needs no server of its own and
 * no key in the page. One form per language, each bound to its own subscription
 * topic, because their submit endpoint keeps the address and drops everything
 * else: a `locale` property sent alongside is not stored, so the *list* is what
 * carries the language. `docs/plans/email.md` in `pilke-app` argues the whole
 * arrangement.
 *
 * **Whether the form takes an address is one explicit switch**, `waitlistOpen`
 * below, and not a read of the privacy statement's `draft` flag. The two
 * questions are different — whether the text is signed off, and whether we are
 * willing to collect an address against it — and clearing `draft` is the act of
 * signing the text off, so it cannot double as the thing that opens a form.
 *
 * The submit handler is this site's only script. It is inline and first-party, so
 * *no analytics, no cookies, no third-party script* stays true as `README.md` §2
 * and the legal pages both claim.
 */
import PetalField from './PetalField.astro';
import { legalDocuments, legalHref } from '../i18n/legal';
import { localePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/*
  The legal links, in the order a reader is offered them: what is done with their
  data, the terms they agreed to, and how to leave. The first two take their label
  from the document's own frontmatter rather than from `ui.ts`, so a document is
  named in one place and the footer cannot call it something the page does not.
*/
const documents = await legalDocuments();

/*
  The hosted form to post to, per language. Not in `ui.ts`: these are not strings
  a reader sees, they are configuration, and a form id in the dictionary would be
  a value the copy review is asked to proofread.

  Both are bound to their own topic — `Beta (fi)` and `Beta (en)` — so the
  invitation months later goes out in the language somebody was reading.
*/
const signupForms: Record<Lang, string> = {
  fi: 'sf_qzh1h7368iwob26hp4vbsdel',
  en: 'sf_1idzwf65ktaq8ni78ph96rk2',
};

/*
  Whether the form takes an address. **Open**, by the owner's decision of 25
  August 2026, while `tietosuoja` is still a draft.

  The note under the field links to the statement either way: it is published,
  readable, and says what happens to the address. What the draft flag still
  means is that no lawyer has read it, and collecting against a statement in
  that state is a position for counsel rather than a property of this component
  — it is recorded in `pilke-app/docs/legal/review-notes.md`.

  Closing the form again is one word here, and the copy for it already exists.
*/
const waitlistOpen = true;

const legal = [
  ...documents.map((document) => ({
    href: legalHref(document.slug, lang),
    label: document.entries[lang].data.title,
  })),
  { href: localePath(lang, 'tietojen-poisto'), label: t('legal.deletion.nav') },
];
---

<footer class="site-foot" id="beta">
  <!--
    The same texture the slabs carry, in grey rather than yellow: the footer is
    the one surface here that is not a slab and not brand-coloured, and a yellow
    field would put it back in the run of them. Faint enough to sit under a form
    without competing with the field it is behind.

    `petal` is an rgba literal rather than a token because it needs alpha and
    `--muted` has none. The alpha is low on purpose: much above this the petals
    read as a pattern and pull the eye off the form they sit behind, so it is set
    to shift the ground by about seven values per channel — present, and not
    something a reader looks at.
  -->
  <PetalField tile={280} background="var(--card-sent)" petal="rgba(128, 128, 128, 0.06)" />

  <div class="wrap foot-inner">
    <div class="foot-copy">
      <h2>{t('cta.title')}</h2>
      <p>{t('cta.body')}</p>
    </div>

    <form
      class="join"
      id="beta-form"
      data-form={signupForms[lang]}
      data-open={waitlistOpen ? 'yes' : 'no'}
    >
      <label for="beta-email">{t('cta.label')}</label>
      <div class="join-row">
        <input
          id="beta-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          disabled={!waitlistOpen}
          placeholder={t('cta.placeholder')}
        />
        {/*
          Their form config names a honeypot field, and this is it. Hidden from
          people and from assistive technology, left empty by anybody real, and
          filled in by the half of the bots that fill in every input they find.
        */}
        <input type="text" name="_hp" tabindex="-1" aria-hidden="true" class="hp" />
        <button class="go send" type="submit" disabled={!waitlistOpen}>
          {t('cta.button')}
        </button>
      </div>
      <p class="note" id="beta-note" role="status">
        {waitlistOpen ? t('cta.note') : t('cta.closed')}{' '}
        {waitlistOpen && <a href={legalHref('tietosuoja', lang)}>{t('cta.privacy')}</a>}
      </p>
    </form>

    <script is:inline define:vars={{ sending: t('cta.sending'), failed: t('cta.failed') }}>
      /*
        One `fetch` and two sentences. Their endpoint answers with the success
        message the form itself is configured with, so the confirmation a reader
        sees is the one set beside the list rather than a second copy of it here.

        Nothing is stored, nothing is measured and no library is loaded: this is
        the whole of the site's JavaScript.
      */
      const form = document.getElementById('beta-form');

      if (form && form.dataset.open === 'yes') {
        const note = document.getElementById('beta-note');
        const field = document.getElementById('beta-email');
        const button = form.querySelector('button');

        form.addEventListener('submit', async (event) => {
          event.preventDefault();

          const email = field.value.trim();
          if (!email) return;

          // A bot that filled the honeypot is answered exactly as a person is,
          // and nothing is sent. Telling it apart is what it came for.
          const trap = form.querySelector('input[name="_hp"]').value;

          button.disabled = true;
          note.textContent = sending;

          if (trap) return;

          try {
            const response = await fetch(
              `https://api.poststack.dev/signup-forms/${form.dataset.form}/submit`,
              {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email }),
              },
            );

            const answer = await response.json();

            if (!response.ok) throw new Error(answer.error || 'refused');

            form.querySelector('.join-row').remove();
            note.textContent = answer.message;
          } catch {
            note.textContent = failed;
            button.disabled = false;
          }
        });
      }
    </script>
  </div>

  <div class="wrap foot-mark">
    <p class="mark">{t('footer.rights')}</p>

    <nav class="foot-legal" aria-label={t('legal.nav')}>
      <ul>
        {legal.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <p class="tagline">{t('hero.title')}</p>
  </div>
</footer>

<style>
  /* No margin and no top border of its own: every section above this one is a
     `.slab`, and a slab already draws a rule along its bottom edge. Adding one
     here put two rules and a gap of pad-large at the foot of every page.

     The one surface on the site that is not yellow. The page above it is a run of
     yellow and off-white slabs, and the block that asks for something should not
     read as one more of them. `--card-sent` is the app's own outgoing-invitation
     tint, so it is a colour the product already uses. */
  .site-foot {
    position: relative;
    isolation: isolate;
    background: var(--card-sent);
  }

  /* The texture is absolutely positioned, so everything over it needs a layer of
     its own — the same arrangement `.slab > .wrap` uses. */
  .site-foot > .wrap {
    position: relative;
    z-index: 1;
  }

  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 3rem);
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .foot-copy {
    flex: 1 1 20rem;
  }

  .foot-copy h2 {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
  }

  .foot-copy p {
    margin-top: var(--pad-medium);
  }

  .join {
    flex: 1 1 22rem;
    max-width: 30rem;
  }

  .join label {
    display: block;
    font-weight: 800;
    font-size: 0.9375rem;
    margin-bottom: var(--pad-small);
  }

  /* The field takes the room and the button keeps its own width, so a long
     button label in either language does not shrink the field it belongs to. */
  .join-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pad-normal);
  }

  /*
    The honeypot. Taken out of the layout and out of the accessibility tree, and
    left focusable by nothing — `display: none` would be simpler and is the one
    thing that does not work, because the bots worth catching skip fields a
    browser would not render.
  */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  /*
    The field and the button while the form is closed. It is drawn rather than
    hidden, because the copy above it is the argument for joining and that
    stands whether or not the box is open.
  */
  .join input:disabled,
  .join button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  /* Drawn as the app draws a field: the same ink edge and radius as a card,
     white ground, and no offset shadow. The button beside it has the shadow, so
     the pair reads as a hole and a raised key rather than as two buttons. */
  .join input {
    flex: 1 1 13rem;
    min-width: 0;
    appearance: none;
    padding: 10px var(--pad-medium);
    background: var(--white);
    color: var(--ink);
    border: var(--edge) solid var(--ink);
    border-radius: var(--radius-normal);
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.4;
  }

  .join input::placeholder {
    color: var(--muted);
  }

  .join input:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  /* Taller than a `.go` elsewhere, and heavier: it stands next to the field and
     has to match the height the field's own padding gives it. */
  .go.send {
    padding: 10px 20px;
    font-weight: 800;
  }

  .note {
    margin-top: var(--pad-normal);
    font-size: 0.875rem;
    color: var(--ink);
    opacity: 0.75;
  }

  /* The wordmark sits under its own rule so it is not read as part of the form.
     A hairline rather than the weight the slabs use: this divides two lines of
     the same footer, and at slab weight it reads as another section boundary. */
  .foot-mark {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--pad-normal);
    border-top: 1px solid var(--ink);
    padding-block: var(--pad-large);
  }

  .mark {
    font-family: var(--font-display);
  }

  /* Between the wordmark and the tagline, and allowed to take the room they do
     not: three links in two languages are wider than either of them. The row
     wraps, so on a narrow screen the links land on their own line rather than
     squeezing the wordmark. */
  .foot-legal {
    flex: 1 1 auto;
  }

  .foot-legal ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--pad-small) var(--pad-medium);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Underlined at rest, unlike the header's nav. These are the links somebody
     goes looking for, and a row of unmarked text at the foot of a page is not
     read as one. */
  .foot-legal a {
    font-size: 0.9375rem;
    color: var(--ink);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .foot-legal a:hover {
    text-decoration-thickness: 2px;
  }

  /* The link inside the note under the field. It sits in a paragraph that is
     already dimmed, so it takes the full ink to stay a link. */
  .note a {
    color: var(--ink);
    text-underline-offset: 2px;
  }

  /* The tagline closes the page on the same words the front page opens with. */
  .tagline {
    font-family: var(--font-display);
    text-align: right;
    color: var(--ink);
    opacity: 0.75;
  }
</style>
