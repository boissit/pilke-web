---
/**
 * The footer is the waitlist. It carries the only thing the site asks for, so it
 * has to be reachable from the safety page and the detail page and not just from
 * the foot of the front page; the hero's button is an anchor down to this.
 *
 * The form posts straight to PostStack's hosted signup form — a public,
 * unauthenticated endpoint — so this static site needs no server of its own and
 * no key in the page. One form per language, each bound to its own subscription
 * topic, because their submit endpoint keeps the address and drops everything
 * else: a `locale` property sent alongside is not stored, so the *list* is what
 * carries the language. `docs/plans/email.md` in `pilke-app` argues the whole
 * arrangement.
 *
 * **Whether the form takes an address is one explicit switch**, `waitlistOpen`
 * below, and not a read of the privacy statement's `draft` flag. The two
 * questions are different — whether the text is signed off, and whether we are
 * willing to collect an address against it — and clearing `draft` is the act of
 * signing the text off, so it cannot double as the thing that opens a form.
 *
 * A page can hand the card a photograph, `photo`, and the front page does: from 64rem
 * it stands beside the copy, and on a phone above it. Every other page's card is the
 * copy alone, because the copy is wrapped in a box that lays out as nothing
 * (`display: contents`) until there is a photograph to sit beside.
 *
 * The submit handler and the header's hide-on-scroll are this site's only scripts.
 * Both are first-party and bundled with the page, so
 * *no analytics, no cookies, no third-party script* stays true as `README.md` §2
 * and the legal pages both claim.
 */
import type { ComponentProps } from 'astro/types';
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import PetalScatter from './PetalScatter.astro';
import RoseMark from './RoseMark.astro';
import { legalDocuments, legalHref } from '../i18n/legal';
import { manualHref } from '../i18n/manual';
import { otherLanguage, otherLanguageHref } from '../i18n/switch';
import { languages, localePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Where the language switch goes, when this page has no twin in the other language. */
  alternate?: string;
  /** A photograph for the card, beside the copy. Only the front page passes one. */
  photo?: { src: ImageMetadata; alt: string };
}

const { lang, alternate, photo } = Astro.props;
const t = useTranslations(lang);

const other = otherLanguage(lang);
const switchHref = alternate ?? otherLanguageHref(Astro.url.pathname, lang);

// The same four the header carries, so the foot of a long page is a way on.
const pages = [
  { href: localePath(lang, 'nain-se-toimii'), label: t('nav.how') },
  { href: localePath(lang, 'turvallisuus'), label: t('nav.safety') },
  { href: localePath(lang, 'kysyttya'), label: t('nav.questions') },
  { href: manualHref(lang), label: t('nav.manual') },
];

/*
  The legal links, in the order a reader is offered them: what is done with their
  data, the terms they agreed to, and how to leave. The first two take their label
  from the document's own frontmatter rather than from `ui.ts`, so a document is
  named in one place and the footer cannot call it something the page does not.
*/
const documents = await legalDocuments();

/*
  The hosted form to post to, per language. Not in `ui.ts`: these are not strings
  a reader sees, they are configuration, and a form id in the dictionary would be
  a value the copy review is asked to proofread.

  Both are bound to their own topic — `Beta (fi)` and `Beta (en)` — so the
  invitation months later goes out in the language somebody was reading.
*/
const signupForms: Record<Lang, string> = {
  fi: 'sf_qzh1h7368iwob26hp4vbsdel',
  en: 'sf_1idzwf65ktaq8ni78ph96rk2',
};

/*
  Whether the form takes an address. **Open**, by the owner's decision of 25
  August 2026, while `tietosuoja` is still a draft.

  The note under the field links to the statement either way: it is published,
  readable, and says what happens to the address. What the draft flag still
  means is that no lawyer has read it, and collecting against a statement in
  that state is a position for counsel rather than a property of this component
  — it is recorded in `pilke-app/docs/legal/review-notes.md`.

  Closing the form again is one word here, and the copy for it already exists.
*/
const waitlistOpen = true;

type Petals = ComponentProps<typeof PetalScatter>['petals'];

const petals: Petals = [
  { shape: 'curl', size: 120, rotate: -24, left: '48px', top: '28px', only: 'wide' },
  { shape: 'spoon', size: 110, rotate: 30, right: '40px', bottom: '40px', only: 'wide' },
  { shape: 'comma', size: 90, rotate: 36, right: '90px', top: '50px', only: 'wide' },
  { shape: 'fan', size: 96, rotate: -14, left: '36px', bottom: '36px', only: 'wide' },
  { shape: 'curl', size: 100, rotate: 30, right: '-20px', top: '30px', only: 'narrow' },
  { shape: 'spoon', size: 70, rotate: -30, left: '-16px', top: '24px', only: 'narrow' },
];

/*
  Beside a photograph the petals keep to the coral the photograph leaves: the left
  side when wide, and the foot of the card when stacked, where the photograph at
  the top would otherwise cut them off at its corners.
*/
const photoPetals: Petals = [
  { shape: 'curl', size: 120, rotate: -24, left: '48px', top: '28px', only: 'wide' },
  { shape: 'fan', size: 96, rotate: -14, left: '36px', bottom: '36px', only: 'wide' },
  { shape: 'curl', size: 100, rotate: 30, right: '-20px', bottom: '40px', only: 'narrow' },
  { shape: 'spoon', size: 70, rotate: -30, left: '-16px', bottom: '120px', only: 'narrow' },
];

const legal = [
  ...documents.map((document) => ({
    href: legalHref(document.slug, lang),
    label: document.entries[lang].data.title,
  })),
  { href: localePath(lang, 'tietojen-poisto'), label: t('legal.deletion.nav') },
];
---


<section class="beta" id="beta" aria-labelledby="beta-title">
  <div class:list={['wrap', 'card', photo && 'with-photo']}>
    <!--
      The wide petals keep to the card's corners. Where they first appear the card is
      not much wider than its headline and its 600px form, and a petal set further
      in lies under the headline or the field.
    -->
    <PetalScatter fill="var(--petal-on-coral)" petals={photo ? photoPetals : petals} />

    {
      photo && (
        <figure class="beta-photo">
          <Image src={photo.src} alt={photo.alt} widths={[360, 720, 1000]} sizes="(min-width: 64rem) 420px, 90vw" />
        </figure>
      )
    }

    <div class="beta-copy">
    <div class="rose"><RoseMark size={80} /></div>
    <h2 id="beta-title">{t('cta.title')}</h2>
    <p class="body">{t('cta.body')}</p>

    <form
      class="join"
      id="beta-form"
      data-form={signupForms[lang]}
      data-open={waitlistOpen ? 'yes' : 'no'}
    >
      <label for="beta-email">{t('cta.label')}</label>
      <div class="join-row">
        <input
          id="beta-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          disabled={!waitlistOpen}
          placeholder={t('cta.placeholder')}
        />
        {/*
          Their form config names a honeypot field, and this is it. Hidden from
          people and from assistive technology, left empty by anybody real, and
          filled in by the half of the bots that fill in every input they find.
        */}
        <input type="text" name="_hp" tabindex="-1" aria-hidden="true" class="hp" />
        <button class="go send" type="submit" disabled={!waitlistOpen}>
          {t('cta.button')}
        </button>
      </div>
      <p class="note" id="beta-note" role="status">
        {waitlistOpen ? t('cta.note') : t('cta.closed')}{' '}
        {waitlistOpen && <a href={legalHref('tietosuoja', lang)}>{t('cta.privacy')}</a>}
      </p>
    </form>

    <script is:inline define:vars={{ sending: t('cta.sending'), failed: t('cta.failed') }}>
      /*
        One `fetch` and two sentences. Their endpoint answers with the success
        message the form itself is configured with, so the confirmation a reader
        sees is the one set beside the list rather than a second copy of it here.

        Nothing is stored, nothing is measured and no library is loaded: this is
        the whole of the site's JavaScript.
      */
      const form = document.getElementById('beta-form');

      if (form && form.dataset.open === 'yes') {
        const note = document.getElementById('beta-note');
        const field = document.getElementById('beta-email');
        const button = form.querySelector('button');

        form.addEventListener('submit', async (event) => {
          event.preventDefault();

          const email = field.value.trim();
          if (!email) return;

          // A bot that filled the honeypot is answered exactly as a person is,
          // and nothing is sent. Telling it apart is what it came for.
          const trap = form.querySelector('input[name="_hp"]').value;

          button.disabled = true;
          note.textContent = sending;

          if (trap) return;

          try {
            const response = await fetch(
              `https://api.poststack.dev/signup-forms/${form.dataset.form}/submit`,
              {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email }),
              },
            );

            const answer = await response.json();

            if (!response.ok) throw new Error(answer.error || 'refused');

            form.querySelector('.join-row').remove();
            note.textContent = answer.message;
          } catch {
            note.textContent = failed;
            button.disabled = false;
          }
        });
      }
    </script>
    </div>
  </div>
</section>

<footer class="site-foot">
  <div class="wrap">
    <div class="foot-top">
      <a class="brand" href={localePath(lang)} aria-label={t('nav.home')}>
        <Logo size={56} class="foot-logo" />
      </a>

      <div class="foot-links">
        <nav aria-label={t('footer.pages')}>
          <ul>
            {pages.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <nav aria-label={t('legal.nav')}>
          <ul>
            {legal.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    <div class="foot-bottom">
      <p>{t('footer.rights')}</p>

      <!--
        The language as a two-way switch rather than one link: the language being
        read is drawn as the chosen half, so a reader who landed in the wrong one
        sees at a glance that there is another, and which of the two they are in.
      -->
      <p class="langs">
        <span class="chosen" aria-current="true">{languages[lang]}</span>
        <a href={switchHref} lang={other} hreflang={other}>{languages[other]}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .beta {
    padding: 0 var(--gutter) clamp(48px, 3.05vw + 36px, 80px);
  }

  /* The coral card: the one surface on the site in the brand's full colour, because
     it is the one place the site asks for something. */
  .card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(16px, 0.76vw + 13px, 24px);
    padding: clamp(40px, 4.57vw + 22px, 88px) clamp(22px, 6.28vw - 2.5px, 88px);
    background: var(--brand-main);
    border-radius: var(--radius-panel);
    text-align: center;
  }

  .beta-copy {
    display: contents;
  }

  /* Stacked, the photograph comes first, a 4:5 of the card's width; wide, it is a
     column to the right of the copy, and the copy keeps its centred run. */
  .beta-photo {
    width: 100%;
    max-width: 360px;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
  }

  .beta-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }

  @media (min-width: 64rem) {
    .card.with-photo {
      flex-direction: row;
      align-items: center;
      gap: clamp(40px, 5vw, 80px);
    }

    .with-photo .beta-copy {
      display: flex;
      flex: 1;
      min-width: 0;
      flex-direction: column;
      align-items: center;
      gap: clamp(16px, 0.76vw + 13px, 24px);
    }

    .with-photo .beta-photo {
      order: 1;
      flex: 0 0 clamp(300px, 29vw, 420px);
      max-width: none;
    }
  }

  .rose :global(svg) {
    height: clamp(64px, 1.52vw + 58px, 80px);
    width: auto;
  }

  h2 {
    font-size: clamp(2.5rem, 3.05vw + 1.8rem, 4.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .body {
    max-width: 540px;
    font-size: clamp(1.0625rem, 0.29vw + 1rem, 1.25rem);
    line-height: 1.55;
  }

  .join {
    align-self: stretch;
    width: 100%;
    max-width: 600px;
    margin: 8px auto 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-align: left;
  }

  .join label {
    padding-left: clamp(20px, 0.38vw + 18.5px, 24px);
    font-size: clamp(0.875rem, 0.1vw + 0.85rem, 0.9375rem);
    font-weight: 700;
  }

  /* The field takes the room and the button keeps its own width, so a long label
     in either language does not shrink the field it belongs to. On a phone the two
     stack, each the full width of the card, as the phone artboard draws them. */
  .join-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /*
    The honeypot. Taken out of the layout and out of the accessibility tree, and
    left focusable by nothing — `display: none` would be simpler and is the one
    thing that does not work, because the bots worth catching skip fields a
    browser would not render.
  */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .join input:not(.hp) {
    flex: 1 1 16rem;
    min-width: 0;
    min-height: clamp(56px, 0.38vw + 54.5px, 60px);
    padding: 0 clamp(20px, 0.38vw + 18.5px, 24px);
    appearance: none;
    background: var(--surface);
    color: var(--text);
    border: 0;
    border-radius: 999px;
    font-family: inherit;
    font-size: 1.0625rem;
  }

  .join input::placeholder {
    color: var(--text-soft);
  }

  .go.send {
    flex: 1 0 auto;
    min-height: clamp(56px, 0.38vw + 54.5px, 60px);
    padding-inline: 30px;
    font-size: 1.0625rem;
  }

  @media (min-width: 40rem) {
    .go.send {
      flex: 0 0 auto;
    }
  }

  /*
    The field and the button while the form is closed. Drawn rather than hidden,
    because the copy above it is the argument for joining and that stands whether
    or not the box is open.
  */
  .join input:disabled,
  .join button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  /* Full ink, not the soft grey: on coral the soft text falls under 4.5:1. */
  .note {
    max-width: none;
    margin-top: 4px;
    padding: 0 clamp(0px, 2.3vw - 9px, 24px);
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: center;
  }

  /* The link keeps the ink under it: the coral underline the rest of the site uses
     would vanish on a coral card, and so would the hover colour. */
  .note a {
    text-decoration-color: var(--text);
  }

  .note a:hover {
    color: var(--text);
    text-decoration-thickness: 3px;
  }

  .site-foot {
    padding: clamp(16px, 2.29vw + 7px, 40px) max(var(--gutter), 24px) clamp(32px, 1.52vw + 26px, 48px);
  }

  .site-foot .wrap {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 2vw + 20px, 64px);
  }

  .foot-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 28px 64px;
  }

  .brand {
    display: inline-flex;
    align-self: flex-start;
    text-decoration: none;
  }

  /* The lockup at the footer's size on a desktop and the smaller one on a phone:
     `Logo` takes a font size, so the word is scaled here and the mark, drawn in em
     from it, follows. */
  .brand :global(.foot-logo) {
    --size: clamp(44px, 1.14vw + 39.5px, 56px) !important;
    --gap: calc(var(--size) * 0.18) !important;
  }

  .brand :global(.foot-logo svg) {
    height: calc(var(--size) * 1.05);
    width: auto;
  }

  /* Two equal columns on a phone, as wide as the footer; two columns as wide as
     their longest link once the logo has the row beside them. */
  .foot-links {
    flex: 1 1 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    font-size: 0.9375rem;
  }

  @media (min-width: 48rem) {
    .foot-links {
      flex: 0 1 auto;
      grid-template-columns: repeat(2, max-content);
      column-gap: clamp(48px, 6.1vw - 8px, 80px);
    }
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .foot-links a {
    text-decoration: none;
  }

  .foot-links a:hover {
    text-decoration: underline;
    text-decoration-color: var(--brand-main);
  }

  .foot-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: clamp(16px, 0.38vw + 14.5px, 20px);
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
    color: var(--text-soft);
  }

  .langs {
    display: flex;
    gap: 4px;
    padding: 4px;
    background: var(--surface);
    border-radius: 999px;
  }

  .langs > * {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 16px;
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
  }

  .chosen {
    background: var(--brand-background);
    font-weight: 600;
  }

  .langs a:hover {
    background: var(--ground);
    color: var(--text);
  }
</style>
