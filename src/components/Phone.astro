---
/**
 * A screenshot in a phone frame.
 *
 * The frame is CSS rather than a picture of a handset: it stays sharp at any size,
 * costs nothing to download, and is drawn in the page's own language — a white
 * shell with a soft shadow, rounded like every card around it.
 *
 * `src` is an imported asset rather than a path, so Astro resizes it and serves a
 * modern format. Straight off the device these are 1080 × 2280.
 *
 * `alt` is required and has no default. These images carry the explaining on a page
 * about how an app works, so a decorative empty alt would be wrong, and a generated
 * one would be worse than the caller writing it.
 *
 * `frame` is one of two drawings, one for the marketing pages and one for the manual.
 * Both show the screen edge to edge, cut to a rounded opening with a punch-hole
 * camera in the middle of the status bar, which is empty on the capture's Pixel 4
 * profile. Neither paints a margin round the picture: a band of one colour inside
 * the opening reads as empty app, not as the phone.
 *
 * **`marketing`, the default: the navigation bar cut, the status bar kept.** The
 * three Android buttons say nothing about Pilke, so the bottom 136 of the 2280 rows
 * come off and the app's own content runs to the foot of the opening, where its
 * button rows already leave a gutter clear of the rounded corners. The status bar
 * stays, because it is what keeps the top of a screen off the top corners: a card or
 * a back button drawn just under the bar would be cut by the curve without it. The
 * marketing stills are taken with SystemUI's demo mode on
 * (`pilke-app/scripts/capture-site-pictures.sh`), so the bar holds only the clock
 * and full signal. The crop is the same on every still because every still is
 * captured on the same emulator profile, and `scripts/photos/stills.py` checks both.
 *
 * **`device` is the manual's phone: both bars kept, in an ink bezel.** A reader
 * matching the manual to their own phone sees the navigation bar too, so it stays,
 * and the screen's corners are the larger curve of a phone's display. The bezel is
 * the app's ink, the colour of every border its buttons and cards have. `shell`
 * is the marketing frame's and does nothing here.
 *
 * Anything in the slot is laid over the picture, in a box exactly its size, so a
 * child positioned in percentages lands on the same pixels at any width. The manual
 * draws its numbered markers there, from bounds measured on the whole still, so the
 * kept bars are also what lets them go on unmoved.
 *
 * `still` is the manual's name for the picture, `fi/kalenteri`, carried on the
 * `<img>` as `data-still`. `npm run pictures` reads the build, and in the build a
 * manual still and a marketing screenshot of the same screen share a file stem; this
 * is how it tells `treffit` the manual step from `treffit` the front page.
 *
 * The drawn width is the page's to set, through `--phone-width` on any ancestor, so a
 * phone can follow its card's layout. `width` is the fallback and what the image is
 * resized for: pass the widest it is ever drawn.
 */
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  /** Degrees clockwise, or a named lean of three degrees. */
  tilt?: 'left' | 'right' | 'none' | number;
  frame?: 'marketing' | 'device';
  /**
   * The shell's colour. White by default, for a phone on a tinted card. On a white
   * card a white shell disappears and the phone reads as a hole, so those pass the
   * peach, or the mint where the screen itself is peach at the top.
   */
  shell?: string;
  /** A deeper shadow, for the one phone that floats over a coloured disc. */
  lifted?: boolean;
  class?: string;
  still?: string;
}

const {
  src,
  alt,
  width = 260,
  tilt = 'none',
  frame = 'marketing',
  shell = 'var(--surface)',
  lifted = false,
  class: className,
  still,
} = Astro.props;

const rotation = typeof tilt === 'number' ? tilt : tilt === 'left' ? -3 : tilt === 'right' ? 3 : 0;

// Twice the drawn width, for a high density display. Anything larger is spent on
// pixels no screen will show.
const rendered = width * 2;
---

<figure
  class:list={['phone', frame, lifted && 'lifted', className]}
  style={`--w:${width}px; --tilt:${rotation}deg; --shell:${shell}`}
>
  <div class="shell">
    <div class="screen">
      <div class="window">
        <Image src={src} alt={alt} width={rendered} densities={[1, 2]} loading="lazy" data-still={still} />
        <span class="camera" aria-hidden="true" />
        {Astro.slots.has('default') && <div class="overlay"><slot /></div>}
      </div>
    </div>
  </div>
</figure>

<style>
  /* A size container, so the corners and the shell's padding are fractions of the
     phone's own width and the frame is one drawing at every size. */
  .phone {
    margin: 0;
    width: var(--phone-width, var(--w));
    max-width: 100%;
    flex: 0 0 auto;
    container-type: inline-size;
    transform: rotate(var(--tilt));
  }

  /* A white shell, about as thin as a phone's bezel, with the soft shadow the site
     gives anything that floats. Its corner is the screen's plus its own padding,
     8 + 3.3, so the two curves run parallel. */
  .shell {
    padding: 3.3cqi;
    background: var(--shell);
    border-radius: 11.3cqi;
    box-shadow: var(--shadow-float);
  }

  .lifted .shell {
    box-shadow: 0 2px 4px rgb(58 46 43 / 0.08), 0 24px 48px rgb(58 46 43 / 0.16);
  }

  /*
    The opening, and the picture cut to it. `overflow` clips the overlay with it.
    The corner is 8.6% of the screen's width, 92 of its 1080 pixels, small enough
    to clear the controls the marketing stills draw nearest their corners: the
    feedback quiz's back button and the tab bar, 23 rows above the cut.
  */
  .screen {
    border-radius: 8cqi;
    overflow: hidden;
  }

  .window {
    position: relative;
  }

  /* The navigation bar, cut: the window is the 1080 × 2144 above it, and the
     picture hangs from the window's top, so its last 136 rows fall outside. */
  .marketing .window {
    aspect-ratio: 1080 / 2144;
    overflow: hidden;
  }

  .window :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The bezel: the app's ink. Its corner is the screen's plus its own padding,
     12.7 + 2.4. */
  .device .shell {
    padding: 2.4cqi;
    background: var(--ink);
    border-radius: 15.1cqi;
  }

  /* The whole still, cut to the bezel's opening. `placeBadges` in `stills.ts` keeps
     every badge inside the picture and clear of this corner. */
  .device .screen {
    border-radius: 12.7cqi;
  }

  /* The front camera, in the middle of the status bar: 48 of the bar's 96 pixels
     down, which is 2.1% of the manual's 2280 rows and 2.24% of the marketing
     frame's 2144. A shade darker than the bezel, as a lens is. */
  .camera {
    position: absolute;
    left: 50%;
    top: 2.24%;
    width: 3%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #1d1d1d;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08);
  }

  .device .camera {
    top: 2.1%;
  }

  .overlay {
    position: absolute;
    inset: 0;
    /* So what is laid over the screen can be sized in the screen's own width. */
    container-type: inline-size;
  }
</style>
