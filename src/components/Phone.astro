---
/**
 * A screenshot in a phone frame.
 *
 * The frame is CSS rather than a picture of a handset: it stays sharp at any size,
 * costs nothing to download, and is drawn in the page's own language — a white
 * shell with a soft shadow, rounded like every card around it.
 *
 * `src` is an imported asset rather than a path, so Astro resizes it and serves a
 * modern format. Straight off the device these are 1080 × 2280.
 *
 * `alt` is required and has no default. These images carry the explaining on a page
 * about how an app works, so a decorative empty alt would be wrong, and a generated
 * one would be worse than the caller writing it.
 *
 * **The screen is inset, and the app's content never reaches the rounded corner.**
 * The stills are cropped tight to the device's edges, so a screen rounded to the
 * shell's radius clipped the corners of whatever the app had drawn there — a card's
 * border, a photo, the tab bar. Instead the picture sits square inside a margin of
 * `ground`, the colour the app itself paints behind that screen, and the rounding
 * happens in that margin. Pass the screen's own entry from `grounds` in
 * `src/assets/screens.ts`; the app's `white` is the default because most screens
 * stand on it.
 *
 * `bars` says what to do with the device's status bar and navigation bar. A
 * marketing shot `crop`s them — the clock and the Android back button say nothing
 * about Pilke, and the Pehmeä artboards draw the screens without them. The crop is
 * the same on every still because every still is captured on the same emulator
 * profile: 96px off the top and 136px off the bottom of 2280. The manual `keep`s
 * them, because its markers are positioned in percentages of the whole picture and a
 * reader matching the manual to their own phone sees those bars too.
 *
 * Anything in the slot is laid over the picture, in a box exactly its size, so a
 * child positioned in percentages lands on the same pixels at any width. The manual
 * draws its numbered markers there, and only uses `keep`.
 *
 * `still` is the manual's name for the picture, `fi/kalenteri`, carried on the
 * `<img>` as `data-still`. `npm run pictures` reads the build, and in the build a
 * manual still and a marketing screenshot of the same screen share a file stem; this
 * is how it tells `treffit` the manual step from `treffit` the front page.
 *
 * The drawn width is the page's to set, through `--phone-width` on any ancestor, so a
 * phone can follow its card's layout. `width` is the fallback and what the image is
 * resized for: pass the widest it is ever drawn.
 */
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  /** Degrees clockwise, or a named lean of three degrees. */
  tilt?: 'left' | 'right' | 'none' | number;
  ground?: string;
  bars?: 'crop' | 'keep';
  /**
   * The shell's colour. White by default, for a phone on a tinted card. On a white
   * card a white shell disappears and the phone reads as a hole, so those pass the
   * peach, or the mint where the screen itself is peach at the top.
   */
  shell?: string;
  /** A deeper shadow, for the one phone that floats over a coloured disc. */
  lifted?: boolean;
  class?: string;
  still?: string;
}

const {
  src,
  alt,
  width = 260,
  tilt = 'none',
  ground = 'var(--white)',
  bars = 'crop',
  shell = 'var(--surface)',
  lifted = false,
  class: className,
  still,
} = Astro.props;

const rotation = typeof tilt === 'number' ? tilt : tilt === 'left' ? -3 : tilt === 'right' ? 3 : 0;

// Twice the drawn width, for a high density display. Anything larger is spent on
// pixels no screen will show.
const rendered = width * 2;
---

<figure
  class:list={['phone', bars, lifted && 'lifted', className]}
  style={`--w:${width}px; --tilt:${rotation}deg; --ground:${ground}; --shell:${shell}`}
>
  <div class="shell">
    <div class="screen">
      <div class="window">
        <Image src={src} alt={alt} width={rendered} densities={[1, 2]} loading="lazy" data-still={still} />
        {Astro.slots.has('default') && <div class="overlay"><slot /></div>}
      </div>
    </div>
  </div>
</figure>

<style>
  /* A size container, so the corners and the shell's padding are fractions of the
     phone's own width and the frame is one drawing at every size. */
  .phone {
    margin: 0;
    width: var(--phone-width, var(--w));
    max-width: 100%;
    flex: 0 0 auto;
    container-type: inline-size;
    transform: rotate(var(--tilt));
  }

  /* The artboards' proportions: a 10px shell and a 50px corner on a 310px phone. */
  .shell {
    padding: 3.3cqi;
    background: var(--shell);
    border-radius: 16cqi;
    box-shadow: var(--shadow-float);
  }

  .lifted .shell {
    box-shadow: 0 2px 4px rgb(58 46 43 / 0.08), 0 24px 48px rgb(58 46 43 / 0.16);
  }

  /*
    The screen: the app's ground, rounded, with the picture held off its edges. The
    margins are the artboards' padded crops — 36 by 68 on a 792-wide screen — so the
    content sits where those put it, and that is enough margin that the picture's
    square corner falls inside the screen's rounded one rather than across it.
  */
  .screen {
    background: var(--ground);
    border-radius: 12.9cqi;
  }

  .crop .screen {
    padding: 8.59% 4.55%;
  }

  .keep .screen {
    padding: 6% 4.55%;
  }

  .window {
    position: relative;
  }

  /* The status bar and the navigation bar, cut: the window is the 1080 × 2048 band
     between them, and the picture is pulled up by the 96 pixels above it. Vertical
     margins in percent are of the width, which is what makes this exact. */
  .crop .window {
    aspect-ratio: 1080 / 2048;
    overflow: hidden;
  }

  .window :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .crop .window :global(img) {
    margin-top: -8.889%;
  }

  .overlay {
    position: absolute;
    inset: 0;
    /* So what is laid over the screen can be sized in the screen's own width. */
    container-type: inline-size;
  }
</style>
