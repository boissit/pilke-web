---
/**
 * The app's sparkle, drawn from the same geometry the product ships.
 *
 * This is the wordmark's sparkle — brand yellow outlined in ink, as `Logo.astro`
 * composes it. The currency's mark is `Token.astro`, which draws the same shape
 * struck on a coin.
 */
import { sparkleShape } from './sparkleShape';

interface Props {
  size?: number;
  fill?: string;
  stroke?: string;
  class?: string;
}

const {
  size = sparkleShape.width,
  fill = 'var(--brand-main)',
  stroke = 'var(--ink)',
  class: className,
} = Astro.props;

const scale = size / sparkleShape.width;
---

<svg
  class={className}
  width={size}
  height={sparkleShape.height * scale}
  viewBox={`0 0 ${sparkleShape.width} ${sparkleShape.height}`}
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d={sparkleShape.path}
    fill={fill}
    stroke={stroke}
    stroke-width="3"
    stroke-linejoin="round"
  />
</svg>
