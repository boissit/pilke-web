---
/**
 * The front page: the phone leads.
 *
 * A large screenshot beside the headline, then the five steps stacked one to a
 * row, each with a screenshot big enough to read. The bet is that a stranger
 * understands an app faster by seeing it than by reading about it, so the
 * pictures get the room and the page gets longer.
 *
 * Safety is a summary here and a page of its own at `turvallisuus`. It is the
 * part of this product with the most to say, which is exactly why it does not
 * belong on a front page: three cards of it read as a warning rather than as an
 * answer to what the app is.
 */
import '../../styles/bold.css';
import Glimmer from '../Glimmer.astro';
import Phone from '../Phone.astro';
import Sparkle from '../Sparkle.astro';
import { content, shots } from './data';
import { localePath } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t, promises, steps, faq } = content(lang);
---

<section class="slab slab-yellow">
  <Glimmer tile={340} background="var(--brand-main)" star="#F7E88A" />
  <div class="wrap hero section-pad">
    <div class="hero-copy">
      <h1 class="display">{t('hero.title')}</h1>
      <p class="lede">{t('hero.lead')}</p>
    </div>
    <Phone src={shots.treffit} alt={t('shot.treffit')} width={300} tilt="right" />
  </div>
</section>

<section class="slab slab-white">
  <div class="wrap section-pad">
    <h2 class="display-mid">{t('promise.title')}</h2>
    <ul class="promises">
      {
        promises.map((item) => (
          <li class="block" style={`background:${item.tint}`}>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="slab slab-white" id="different">
  <div class="wrap section-pad">
    <h2 class="display-mid">{t('diff.title')}</h2>
    <p class="lede">{t('diff.lead')}</p>

    <!--
      Two columns rather than a table of ticks and crosses. The comparison is
      between two ways of spending an evening, and both descriptions have to be
      recognisable to somebody who has done the first one, or the section reads as
      a swipe at the reader's own habits rather than at the shape of the thing.
    -->
    <div class="compare">
      <article class="side">
        <p class="side-label">{t('diff.old.label')}</p>
        <h3>{t('diff.old.title')}</h3>
        <p>{t('diff.old.body')}</p>
      </article>

      <article class="side ours">
        <p class="side-label">{t('diff.new.label')}</p>
        <h3>{t('diff.new.title')}</h3>
        <p>{t('diff.new.body')}</p>
      </article>
    </div>

    <div class="learn">
      <Sparkle size={34} />
      <div>
        <h3>{t('diff.learn.title')}</h3>
        <p class="prose">{t('diff.learn.body')}</p>
      </div>
    </div>
  </div>
</section>

<section class="slab slab-pale" id="how">
  <Glimmer tile={300} />
  <div class="wrap section-pad">
    <h2 class="display-mid">{t('how.title')}</h2>
    <p class="lede">{t('how.lead')}</p>

    <!--
      One step per row, stacked. A row of five side by side left each phone about
      190px wide, which is too small to read a screen in, and on a narrow screen
      it became a sideways scroll that is easy to miss entirely. Vertical costs
      page length and buys a legible screenshot, which is the whole point of
      leading with the phone.
    -->
    <ol class="steps">
      {
        steps.map((step, i) => (
          <li>
            <div class="step-copy">
              <!--
                The number sits on the title's line rather than above it, so the
                eye reads "1 Lahetä treffikutsu" as one heading instead of a
                figure and then a heading.
              -->
              <div class="step-head">
                <span class="numeral">{i + 1}</span>
                <h3 class="step-title">{step.title}</h3>
              </div>
              <p>{step.body}</p>
            </div>
            {step.shot ? (
              <Phone src={step.shot} alt={step.alt} width={300} tilt={i % 2 === 0 ? 'right' : 'left'} />
            ) : (
              <div class="placeholder" aria-hidden="true"><Sparkle size={64} /></div>
            )}
          </li>
        ))
      }
    </ol>

    <!--
      The link sits after the four steps, not before them: it offers more detail
      to somebody who has just read the summary, and at the top it competed with
      the summary it is meant to follow.
    -->
    <p class="loop">{t('how.loop')}</p>
    <p><a class="go" href={localePath(lang, 'nain-se-toimii')}>{t('how.more')}</a></p>
  </div>
</section>

<section class="slab slab-white">
  <div class="wrap section-pad">
    <h2 class="display-mid">{t('economy.title')}</h2>

    <!--
      The exchange as one line, because it is one fact with a direction: petals
      go in, a rose comes out. Two cards side by side stated it twice and put the
      currencies in competition, which is the wrong shape for a rate.
    -->
    <p class="rate">
      <span class="coin">
        <img src="/img/petal.png" alt="" width="46" height="43" />
        <b>5</b>
      </span>
      <span class="equals" aria-hidden="true">=</span>
      <span class="coin">
        <img src="/img/rose.png" alt="" width="40" height="46" />
        <b>1</b>
      </span>
      <span class="rate-words">{t('economy.lead')}</span>
    </p>

    <div class="ledger">
      <div class="earn">
        <h3>{t('economy.earn.title')}</h3>
        <!--
          A description list, because that is what this is: each way of earning
          and the amount it pays. The amount is the value of the term beside it,
          so a reader who tabs through hears them paired.
        -->
        <dl>
          <div><dt>{t('economy.earn.signup')}</dt><dd>{t('economy.amount.five')}</dd></div>
          <div><dt>{t('economy.earn.calendar')}</dt><dd>{t('economy.amount.one')}</dd></div>
          <div><dt>{t('economy.earn.date')}</dt><dd>{t('economy.amount.two')}</dd></div>
        </dl>
        <p class="note">{t('economy.note')}</p>
      </div>

      <div class="spend block">
        <h3>{t('economy.spend.title')}</h3>
        <p>{t('economy.spend.body')}</p>
      </div>
    </div>
  </div>
</section>

<section class="slab slab-yellow" id="safety">
  <div class="wrap section-pad safety">
    <div class="safety-copy">
      <h2 class="display-mid">{t('safety.title')}</h2>
      <p class="lede">{t('safety.summary')}</p>
      <p><a class="go" href={localePath(lang, 'turvallisuus')}>{t('safety.more')}</a></p>
    </div>
    <Phone src={shots.asetukset} alt={t('shot.asetukset')} width={230} tilt="left" />
  </div>
</section>

<section class="slab slab-white" id="faq">
  <div class="wrap section-pad">
    <h2 class="display-mid">{t('faq.title')}</h2>
    <dl class="faq">
      {
        faq.map((item) => (
          <div class="qa">
            <dt>{item.q}</dt>
            <dd class="prose">{item.a}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--pad-large);
  }

  .hero-copy {
    flex: 1 1 20rem;
  }

  .hero-copy > * + * {
    margin-top: var(--pad-medium);
  }

  .wrap > * + * {
    margin-top: var(--pad-medium);
  }

  .promises {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--pad-medium);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  /* The rate reads as one sentence with two coins in it. */
  .rate {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--pad-normal);
    max-width: none;
  }

  .coin {
    display: flex;
    align-items: center;
    gap: var(--pad-small);
    padding: 6px 14px 6px 8px;
    background: var(--brand-background);
    border: 3px solid var(--ink);
    border-radius: 999px;
  }

  .coin b {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
  }

  .equals {
    font-family: var(--font-display);
    font-size: 1.75rem;
  }

  .rate-words {
    flex: 1 1 18rem;
    font-size: 1.0625rem;
  }

  .ledger {
    display: grid;
    gap: var(--pad-medium);
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    align-items: start;
  }

  .earn dl {
    margin: var(--pad-normal) 0 0;
    display: grid;
    gap: 0;
  }

  .earn dl > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--pad-normal);
    padding: var(--pad-normal) 0;
    border-top: 3px solid var(--ink);
  }

  .earn dl > div:last-child {
    border-bottom: 3px solid var(--ink);
  }

  .earn dt {
    flex: 1 1 12rem;
    font-weight: 400;
    font-size: 1rem;
  }

  /* The amounts line up, so they are read as a column of figures. */
  .earn dd {
    margin: 0;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .spend {
    background: var(--brand-background);
  }

  .spend > * + * {
    margin-top: var(--pad-small);
  }

  .note {
    margin-top: var(--pad-normal);
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .block > * + * {
    margin-top: var(--pad-small);
  }

  /* One step per row: copy on one side, phone on the other, alternating. Only
     the visual order alternates; the reading order stays the document's. */
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--pad-large);
  }

  /* Centred on both axes, with the copy capped at a measure. Left-aligned
     columns of unequal height put the text's first line and the phone's top edge
     at different heights on every row, which is what read as misaligned. */
  .steps > li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--pad-large);
    padding-bottom: var(--pad-large);
    border-bottom: 3px solid var(--ink);
  }

  .steps > li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .steps > li:nth-child(even) {
    flex-direction: row-reverse;
  }

  .step-copy {
    flex: 1 1 20rem;
    max-width: 65ch;
  }

  .step-copy > * + * {
    margin-top: var(--pad-normal);
  }

  .step-head {
    display: flex;
    align-items: center;
    gap: var(--pad-normal);
  }

  /* The title takes the rest of the line and wraps under itself, not under the
     number, so a long title stays a block of text beside the figure. */
  .step-head .step-title {
    flex: 1;
  }

  .compare {
    display: grid;
    gap: var(--pad-medium);
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
  }

  .side {
    padding: var(--pad-medium);
    border: 3px solid var(--ink);
    border-radius: var(--radius-large);
    background: var(--white);
  }

  /* Ours carries the brand ground and the offset edge; the other column is drawn
     plainly. The difference in weight is the argument, so it does not need a
     cross next to it. */
  .side.ours {
    background: var(--brand-background);
    box-shadow: 5px 5px 0 var(--ink);
  }

  .side > * + * {
    margin-top: var(--pad-small);
  }

  .side-label {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .side.ours .side-label {
    color: var(--ink);
  }

  .learn {
    display: flex;
    align-items: flex-start;
    gap: var(--pad-medium);
    max-width: 65ch;
  }

  .learn > div > * + * {
    margin-top: var(--pad-small);
  }

  .loop {
    max-width: 65ch;
    font-size: 1.0625rem;
  }

  .step-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.15;
  }

  .placeholder {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 300px;
    max-width: 100%;
    height: 14rem;
    background: var(--white);
    border: 3px dashed var(--ink);
    border-radius: var(--radius-large);
  }

  .safety {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--pad-large);
  }

  .safety-copy {
    flex: 1 1 22rem;
  }

  .safety-copy > * + * {
    margin-top: var(--pad-medium);
  }

  .go {
    display: inline-block;
    padding: 8px 18px;
    background: var(--white);
    border: 3px solid var(--ink);
    border-radius: var(--radius-normal);
    font-weight: 700;
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--ink);
  }

  .go:hover {
    transform: translate(1px, 1px);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .faq {
    margin: 0;
    display: grid;
    gap: var(--pad-normal);
  }

  .qa {
    border-top: 3px solid var(--ink);
    padding-top: var(--pad-normal);
  }

  dt {
    font-weight: 800;
    font-size: 1.0625rem;
  }

  dd {
    margin: var(--pad-small) 0 0;
  }
</style>
