---
/**
 * The card a subpage opens with: title, lede, and a few sparkles behind them.
 *
 * The front page opens with the hero instead, which is a different arrangement — a
 * headline beside a phone. Every other page opens identically, so they open from here,
 * and the peach card at the top of one of them cannot drift from the rest. It is the
 * hero's ground and the hero's sparkles, so a reader who came from the front page is
 * visibly on the same site.
 *
 * A lede with a link in it comes in the `lead` slot instead of the prop, as the
 * 404's does. Anything else in the card, as the about page's story is, comes in
 * the default slot, under the title and the lede if there is one.
 */
import SparkleScatter from './SparkleScatter.astro';

interface Props {
  title: string;
  lead?: string;
  /**
   * The card's ground: the hero's peach, or white for a page whose next card is
   * the peach one, as the about page's timeline is. The sparkles are the peach
   * card's on either.
   */
  ground?: 'pale' | 'white';
}

const { title, lead, ground = 'pale' } = Astro.props;
---

<section class:list={['slab', `slab-${ground}`, 'head']}>
  <div class="wrap section-pad">
    <SparkleScatter
      fill="var(--sparkle-on-peach)"
      sparkles={[
        { size: 120, rotate: 14, right: '9%', top: '28px', only: 'wide' },
        { size: 46, rotate: -24, right: 'calc(9% + 140px)', top: '40px', only: 'wide' },
        { size: 64, rotate: 14, right: '14px', top: '14px', only: 'narrow' },
        { size: 26, rotate: -24, right: '86px', top: '22px', only: 'narrow' },
        { size: 130, rotate: -20, right: '26%', bottom: '-48px', only: 'wide' },
        { size: 38, rotate: 32, right: 'calc(26% - 50px)', bottom: '40px', only: 'wide' },
      ]}
    />
    <h1 class="display-mid">{title}</h1>
    {(lead || Astro.slots.has('lead')) && <p class="lede">{Astro.slots.has('lead') ? <slot name="lead" /> : lead}</p>}
    <slot />
  </div>
</section>

<style>
  /* The head sits a little tighter under the header than a section under another. */
  .head {
    padding-top: clamp(4px, 1.52vw - 2px, 16px);
  }

  /* Room on the right for the sparkle, so a long title never runs under it. */
  h1 {
    max-width: min(18ch, calc(100% - 64px));
    font-size: clamp(2.5rem, 2.67vw + 1.85rem, 4.25rem);
  }

  .lede {
    margin-top: clamp(12px, 0.76vw + 9px, 20px);
    max-width: 44ch;
  }
</style>
