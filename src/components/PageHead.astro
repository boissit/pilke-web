---
/**
 * The slab a subpage opens with: title, lede, and the petal field behind them.
 *
 * The front page opens with the hero instead, which is a different arrangement —
 * a headline beside a phone. The other three open identically, so they open from
 * here, and a yellow band at the top of one of them cannot drift from the rest.
 */
import PetalField from './PetalField.astro';

interface Props {
  title: string;
  lead: string;
}

const { title, lead } = Astro.props;
---

<section class="slab slab-yellow">
  <PetalField tile={320} background="var(--brand-main)" petal="#F7E88A" />
  <div class="wrap section-pad head">
    <h1 class="display-mid">{title}</h1>
    <p class="lede">{lead}</p>
  </div>
</section>

<style>
  .head > * + * {
    margin-top: var(--pad-medium);
  }

  /* Narrower than the ledes further down a page. This one sits under a display
     title with nothing beside it, and at the full measure it runs wider than the
     title it belongs to. */
  .head .lede {
    max-width: 44ch;
  }
</style>
