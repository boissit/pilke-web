---
/**
 * One step of a manual page: the screenshot in a phone, numbered, with the step's text
 * beside it.
 *
 * Side by side where there is room and stacked where there is not, by the same
 * flex-wrap `nain-se-toimii` sets its phones and columns with: the text column has a
 * basis, and when the row cannot fit it beside the phone it wraps under. No breakpoint,
 * so it is right at whatever width a phone in portrait or a tablet in landscape is.
 *
 * The markers are drawn over the picture from the sidecar's bounds and hidden from
 * assistive technology. They are a way to point at part of an image for somebody
 * looking at it; the alt text and the step's own words carry the same thing for
 * somebody who is not, and a stray "1" read out after the alt would be noise.
 *
 * The slot is the step's text as HTML, and it is styled by `.manual` in `soft.css`
 * rather than here, because Markdown output carries no scope attribute.
 */
import Phone from './Phone.astro';
import { useTranslations } from '../i18n/ui';
import { BADGE_SHARE, type Marker, type Still } from '../manual/stills';

interface Props {
  still: Still;
}

const { still } = Astro.props;
const t = useTranslations(still.lang);

const id = `${still.lang}/${still.name}`;
const badgeSize = `${BADGE_SHARE * 100}%`;

/**
 * The point on the element's outline nearest its badge, where the badge's leader ends.
 * Clamping the badge's centre into the box finds it in percentages as well as in
 * pixels, so this needs neither the still's size nor the phone's.
 */
function leaderEnd(marker: Marker): { x: number; y: number } {
  const clamp = (value: number, from: number, size: number) => Math.min(Math.max(value, from), from + size);
  return { x: clamp(marker.badgeLeft, marker.left, marker.width), y: clamp(marker.badgeTop, marker.top, marker.height) };
}
---

<div class="step">
  {
    still.image ? (
      <Phone src={still.image} alt={still.alt} width={280} still={id} bars="keep" shell="var(--ground)">
        {still.markers.length > 0 && (
          <svg class="leaders" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {still.markers.map((marker) => {
              const end = leaderEnd(marker);
              return <line x1={marker.badgeLeft} y1={marker.badgeTop} x2={end.x} y2={end.y} />;
            })}
          </svg>
        )}
        {still.markers.map((marker) => (
          <>
            <span
              class="marker"
              aria-hidden="true"
              style={`left:${marker.left}%;top:${marker.top}%;width:${marker.width}%;height:${marker.height}%`}
            />
            <span
              class="badge"
              aria-hidden="true"
              style={`left:${marker.badgeLeft}%;top:${marker.badgeTop}%;width:${badgeSize}`}
            >
              {marker.number}
            </span>
          </>
        ))}
      </Phone>
    ) : (
      /*
        Drawn the size and shape of the phone it stands in for, so the page reads as it
        will once the still exists, and dashed, which is how this site draws something
        that is not settled. The alt is printed because it is the only description of
        the picture there is yet, and the name because it is what to go and capture.
      */
      <figure class="missing" data-still-missing={id}>
        <p class="missing-title">{t('manual.shot.missing')}</p>
        <p class="missing-alt">{still.alt}</p>
        <code>{still.name}</code>
      </figure>
    )
  }

  <div class="step-text">
    <slot />
  </div>
</div>

<style>
  .step {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    /* Only tells once the text has wrapped under: the phone then sits in the middle
       of a phone-width page rather than hard against one edge. */
    justify-content: center;
    gap: clamp(28px, 3vw, 48px);
  }

  .step-text {
    flex: 1 1 22rem;
    min-width: 0;
  }

  /*
    The annotation layer: the ring round an element, the badge that numbers it and
    the leader between them, all in `--annotation` and nothing else.

    WARNING: **None of it may look like part of the app, or of this site.** The
    screenshots are the app's own coral fills, ink borders and flat offset shadows,
    which is every control a reader is about to look for, and the page around them
    is peach, coral and mint; a marker drawn in any of those reads as one more
    button on the screen. Blue, a dashed edge, a sans numeral and no shadow
    are what a hand marking up a screenshot draws, and nothing the app draws is any
    of them. The white on each side is what keeps them visible on a dark map as
    well as on a pale card.
  */

  /* The bounds of the element, so a big one reads as an area and a small one as
     a target. Dashed, because a solid ring round a card reads as the card's own
     border. */
  .marker {
    position: absolute;
    border: 2px dashed var(--annotation);
    border-radius: var(--radius-small);
    background: var(--annotation-wash);
    box-shadow:
      0 0 0 1.5px var(--annotation-halo),
      inset 0 0 0 1.5px var(--annotation-halo);
    pointer-events: none;
  }

  /* From the badge's centre to the nearest point of its ring. The badge covers its
     own half, so what shows is the short run across the gap that ties the two
     together when two elements sit close. The viewBox is the still in percent, and
     the stroke keeps its width whatever the stretch. */
  .leaders {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .leaders line {
    stroke: var(--annotation);
    stroke-width: 2px;
    vector-effect: non-scaling-stroke;
  }

  /* Its centre and width come from `placeBadges` in `stills.ts`, which puts it
     beside the element it numbers; the width is a share of the screen, so the
     numeral is sized in the same units. */
  .badge {
    position: absolute;
    transform: translate(-50%, -50%);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background: var(--annotation);
    color: var(--annotation-halo);
    border: 1.5px solid var(--annotation-halo);
    border-radius: 50%;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 6cqw;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  /* The phone is 280 wide by the 1080 × 2280 the stills are captured at, with the
     frame's corner. */
  .missing {
    flex: 0 0 auto;
    width: 280px;
    max-width: 100%;
    aspect-ratio: 1080 / 2280;
    margin: 0;
    padding: var(--pad-medium);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--pad-normal);
    text-align: center;
    background: var(--ground);
    border: 2px dashed var(--brand-main);
    border-radius: 45px;
  }

  .missing-title {
    font-weight: 700;
  }

  .missing-alt {
    font-size: 0.9375rem;
  }

  .missing code {
    font-size: 0.8125rem;
    color: var(--text-soft);
  }
</style>
