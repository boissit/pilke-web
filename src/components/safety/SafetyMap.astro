---
/**
 * The safety card: identification and the venues as equals. The copy is the owner's
 * two lines; the picture is real date spots as pins on central Helsinki (OpenFreeMap
 * tiles recoloured to the site's grounds, `scripts/map/`), and two agreed dates
 * placed at their own venues: each date's card, cut out of the app's date page
 * (`src/assets/cards.ts`), stands over the map's edge nearest its pin, tilted a
 * little, with an ink line from the card to the coral pin. The other venues are
 * white pins.
 *
 * It lays itself out by its own width rather than the page's, so it works full
 * width (copy left, map right) and narrower (map under the copy). On a phone the
 * two cards stand under the map, without the lines.
 *
 * The faces are the mock cast's (`treffit-backend/test/`, Unsplash, credited in
 * `treffit_backend/mocks/data.py`), sample profiles never captioned as Pilke users.
 */
import { Image } from 'astro:assets';
import { cardsFor } from '../../assets/cards';
import map from '../../assets/maps/keskusta.png';
import { type Lang, localePath, useTranslations } from '../../i18n/ui';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// In percent of `keskusta.png`, from `scripts/map/render.mjs`. `date` marks the two
// venues the dates are at: their cards name them, so their pins carry no label.
const pins = [
  { name: 'Kaffecentralen', x: 16.91, y: 51.13 },
  { name: 'Ateljée Bar', x: 43.03, y: 48.87 },
  { name: 'Café Aalto', x: 65.24, y: 44.37, date: true },
  { name: 'Karl Fazer Café', x: 82.66, y: 41 },
  { name: 'Esplanadin puisto', x: 82.22, y: 52.25, date: true },
];

const cards = cardsFor(lang);

const points = [
  { icon: 'badge-check', tint: 'var(--success)', title: t('safety.verified.title'), body: t('pitch.safety.verified') },
  { icon: 'map-pin', tint: 'var(--brand-main)', title: t('pitch.safety.venues.title'), body: t('pitch.safety.venues') },
];
---

<section class="slab slab-mint safety" aria-labelledby="safety-title">
  <div class="wrap section-pad">
    <div class="inner">
      <div class="copy">
        <h2 class="display-mid" id="safety-title">{t('pitch.safety.title')}</h2>
        <ul class="points">
          {
            points.map((p) => (
              <li>
                <span class="dot" style={`background:${p.tint}`}><Icon name={p.icon} size={22} /></span>
                <div>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="more"><a class="go" href={localePath(lang, 'turvallisuus')}>{t('safety.more')}</a></p>
      </div>

      <div class="stage">
        <div class="stage-map">
        <div class="map" role="img" aria-label={t('pitch.safety.map.alt')}>
          <Image src={map} alt="" width={900} densities={[1, 2]} loading="lazy" />
          {
            pins.map((p) => (
              <span class:list={['pin', p.date && 'is-date']} style={`left:${p.x}%; top:${p.y}%`}>
                <Icon name="map-pin" size={p.date ? 32 : 24} />
                {!p.date && <span class="label">{p.name}</span>}
              </span>
            ))
          }
          <span class="credit">{t('pitch.safety.map.credit')}</span>
        </div>

        {/* Ink lines from each card to its pin, in the map's own percentages. */}
        <svg class="links" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <line x1="44" y1="9" x2="64.4" y2="37.5" />
          <line x1="76" y1="91" x2="82.2" y2="53.5" />
        </svg>
        <div class="dates" role="img" aria-label={t('pitch.safety.dates.alt')}>
          <Image src={cards.riikka} alt="" width={680} densities={[1, 2]} class="date riikka" loading="lazy" />
          <Image src={cards.henri} alt="" width={680} densities={[1, 2]} class="date henri" loading="lazy" />
        </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .safety {
    display: grid;
  }

  .safety > .wrap {
    container-type: inline-size;
  }

  .inner {
    display: grid;
    gap: clamp(28px, 2.3vw + 19px, 48px);
  }

  .copy {
    display: grid;
    gap: clamp(18px, 1.14vw + 14px, 28px);
    align-content: start;
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }

  .points li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .dot {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--ink);
  }

  .points h3 {
    font-size: clamp(1.25rem, 0.38vw + 1.16rem, 1.5rem);
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .points p,
  .more {
    margin: 0;
  }

  .points p {
    line-height: 1.55;
    color: var(--text-soft);
  }

  /* ─── The map ─────────────────────────────────────────────────────────── */

  .stage {
    position: relative;
  }

  .map {
    position: relative;
    aspect-ratio: 9 / 7;
    border: 3px solid var(--ink);
    border-radius: 24px;
    overflow: hidden;
  }

  .map :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The other venues white, the two dates' coral and larger. */
  .pin {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translate(-50%, -100%);
    color: var(--ink);
  }

  .pin :global(svg) {
    display: block;
    fill: var(--surface);
  }

  .pin.is-date :global(svg) {
    fill: var(--brand-main);
  }

  .label {
    position: absolute;
    top: 100%;
    margin-top: 2px;
    white-space: nowrap;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--surface);
  }

  /* At the top, where the dates never cover it. */
  .credit {
    position: absolute;
    right: 10px;
    top: 6px;
    font-size: 0.65rem;
    color: var(--text-soft);
  }

  /* ─── The two dates ───────────────────────────────────────────────────── */

  /* A phone: the two cards under the map, one a little in from each side. */
  .links {
    display: none;
  }

  .dates {
    display: grid;
    gap: 10px;
    margin-top: -18px;
    position: relative;
  }

  .dates :global(.date) {
    display: block;
    width: 88%;
    height: auto;
  }

  .dates :global(.riikka) {
    transform: rotate(-1.5deg);
  }

  .dates :global(.henri) {
    justify-self: end;
    transform: rotate(1.5deg);
  }

  /* On a phone the names would run into each other: the pins say enough. */
  @container (max-width: 34rem) {
    .label {
      display: none;
    }

    .pin:not(.is-date) :global(svg) {
      width: 20px;
      height: 20px;
    }
  }

  /*
    Room for the composition: each card over the map's edge nearest its pin, Riikka
    across the top left towards Café Aalto, Henri across the bottom right below
    Esplanadin puisto, with the ink lines drawn to the pins. The stage pads above
    and below for the part of each card that stands off the map.
  */
  @container (min-width: 34rem) {
    .stage {
      padding-block: 7% 9%;
    }

    .stage-map {
      position: relative;
    }

    .links {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
      pointer-events: none;
    }

    .links line {
      stroke: var(--ink);
      stroke-width: 2.5;
      stroke-linecap: round;
      stroke-dasharray: 1 7;
      vector-effect: non-scaling-stroke;
    }

    .dates {
      position: absolute;
      inset: 0;
      margin: 0;
      display: block;
      pointer-events: none;
    }

    .dates :global(.date) {
      position: absolute;
      width: 52%;
    }

    .dates :global(.riikka) {
      left: -5%;
      top: -7%;
    }

    .dates :global(.henri) {
      right: -4%;
      bottom: -9%;
    }
  }

  @container (min-width: 52rem) {
    .inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: center;
    }
  }
</style>
