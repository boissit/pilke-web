---
/**
 * Option C: a big statement, no pictures. The two features as two large rows, each
 * a big icon disc, a display-sized heading and the owner's line at lede size. Side
 * by side with a rule between them from 56rem, stacked before that.
 */
import { type Lang, localePath, useTranslations } from '../../i18n/ui';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const points = [
  { icon: 'badge-check', tint: 'var(--success)', title: t('safety.verified.title'), body: t('pitch.safety.verified') },
  { icon: 'map-pin', tint: 'var(--brand-main)', title: t('pitch.safety.venues.title'), body: t('pitch.safety.venues') },
];
---

<section class="slab slab-mint" aria-labelledby="safety-title">
  <div class="wrap section-pad statement">
    <h2 class="kicker" id="safety-title">{t('pitch.safety.title')}</h2>
    <div class="rows">
      {
        points.map((p) => (
          <div class="row">
            <span class="disc" style={`background:${p.tint}`}>
              <Icon name={p.icon} size={40} strokeWidth={1.75} />
            </span>
            <h3 class="display-mid">{p.title}</h3>
            <p class="lede">{p.body}</p>
          </div>
        ))
      }
    </div>
    <p><a class="go" href={localePath(lang, 'turvallisuus')}>{t('safety.more')}</a></p>
  </div>
</section>

<style>
  .statement {
    display: grid;
    gap: clamp(24px, 2.3vw + 15px, 48px);
  }

  /* The section's name small, over the two big lines it introduces. */
  .kicker {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.125rem, 0.38vw + 1.03rem, 1.375rem);
    letter-spacing: 0.02em;
    color: var(--text-soft);
  }

  .rows {
    display: grid;
    gap: clamp(32px, 2.3vw + 23px, 48px);
  }

  .row {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .disc {
    display: grid;
    place-items: center;
    width: clamp(64px, 1.5vw + 58px, 80px);
    height: clamp(64px, 1.5vw + 58px, 80px);
    border-radius: 50%;
    color: var(--ink);
  }

  .row .lede {
    margin: 0;
    max-width: 38ch;
  }

  @media (min-width: 56rem) {
    .rows {
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }

    .row + .row {
      border-left: 2px dashed var(--rule-strong, #c9e2d9);
      padding-left: clamp(32px, 3vw, 56px);
    }

    .row:first-child {
      padding-right: clamp(32px, 3vw, 56px);
    }
  }
</style>
