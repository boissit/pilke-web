---
/**
 * Option B: one "app moment" showing both at once. An agreed date drawn after the
 * app's date card: the venue on the map, the person with the verified badge, and
 * where and when. Two numbered markers sit on the badge and on the venue, and the
 * copy beside it is the same two numbers, so the picture explains itself.
 * Copy and card side by side from 56rem, the card first on a phone.
 */
import { Image } from 'astro:assets';
import juho from '../../assets/cast/juho.jpg';
import map from '../../assets/maps/keskusta.png';
import { type Lang, localePath, useTranslations } from '../../i18n/ui';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Café Aalto on `keskusta.png` as this 16:10 crop of it shows it (the 9:7 picture,
// cut top and bottom), in percent, from `scripts/map/render.mjs`.
const pin = { x: 65.24, y: 43.0 };

const points = [
  { title: t('safety.verified.title'), body: t('pitch.safety.verified') },
  { title: t('pitch.safety.venues.title'), body: t('pitch.safety.venues') },
];
---

<section class="slab slab-mint" aria-labelledby="safety-title">
  <div class="wrap section-pad moment">
    <h2 class="display-mid" id="safety-title">{t('pitch.safety.title')}</h2>

    <div class="date-card" role="img" aria-label={t('card.verified.alt')}>
      <div class="map">
        <Image src={map} alt="" width={720} densities={[1, 2]} loading="lazy" />
        <span class="venue-pin" style={`left:${pin.x}%; top:${pin.y}%`}><Icon name="map-pin" size={26} /></span>
        <span class="credit">{t('pitch.safety.map.credit')}</span>
        <span class="marker m2" style={`left:calc(${pin.x}% + 22px); top:calc(${pin.y}% - 34px)`}>2</span>
      </div>
      <div class="who">
        <Image src={juho} alt="" width={128} densities={[1, 2]} class="face" loading="lazy" />
        <p class="name">
          <b>Juho</b>, 25<span class="badge-wrap"><Icon name="badge-check" size={20} class="badge" /><span class="marker m1">1</span></span>
        </p>
      </div>
      <div class="where">
        <p class="venue">Café Aalto</p>
        <p class="blurb">{t('venue.blurb.aalto')}</p>
        <p class="when">{t('venue.time')}</p>
      </div>
    </div>

    <ol class="points">
      {
        points.map((p, i) => (
          <li>
            <span class="marker" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="more"><a class="go" href={localePath(lang, 'turvallisuus')}>{t('safety.more')}</a></p>
  </div>
</section>

<style>
  .moment {
    display: grid;
    gap: clamp(20px, 1.52vw + 14px, 32px);
    grid-template-areas: 'title' 'card' 'points' 'more';
  }

  .moment > h2 {
    grid-area: title;
  }

  @media (min-width: 56rem) {
    .moment {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'title card' 'points card' 'more card';
      grid-template-rows: auto auto 1fr;
      column-gap: clamp(32px, 4vw, 72px);
    }
  }

  /* The app's date card: an ink border, the confirmed peach, no shadow. */
  .date-card {
    grid-area: card;
    justify-self: center;
    align-self: center;
    width: min(100%, 440px);
    border: 3px solid var(--ink);
    border-radius: 22px;
    background: var(--card-confirmed);
    overflow: visible;
  }

  .map {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 19px 19px 0 0;
    border-bottom: 3px solid var(--ink);
  }

  .map :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 19px 19px 0 0;
  }

  .credit {
    position: absolute;
    right: 8px;
    bottom: 4px;
    font-size: 0.62rem;
    color: var(--text-soft);
  }

  .venue-pin {
    position: absolute;
    transform: translate(-50%, -90%);
    color: var(--ink);
  }

  .venue-pin :global(svg) {
    fill: var(--brand-main);
  }

  .who {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px 6px;
  }

  .who :global(.face) {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 2.5px solid var(--ink);
    object-fit: cover;
  }

  .name {
    margin: 0;
    display: flex;
    align-items: center;
    font-size: 1.5rem;
  }

  .name b {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .badge-wrap {
    position: relative;
    display: inline-grid;
    margin-left: 7px;
  }

  .badge-wrap :global(.badge) {
    fill: var(--success);
  }

  .where {
    padding: 4px 16px 16px;
  }

  .where p {
    margin: 0;
  }

  .venue {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
  }

  .blurb,
  .when {
    font-size: 0.92rem;
    color: var(--text-soft);
  }

  .when {
    margin-top: 6px !important;
    font-weight: 700;
    color: var(--ink);
  }

  /* The numbered markers: flat coral discs, the same on the card and in the list. */
  .marker {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--brand-main);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
  }

  .m1,
  .m2 {
    position: absolute;
    border: 2.5px solid var(--ink);
  }

  .m1 {
    left: 24px;
    top: -22px;
  }

  .points {
    grid-area: points;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
  }

  .points li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .points .marker {
    width: 36px;
    height: 36px;
    font-size: 1.15rem;
  }

  .points h3 {
    font-size: clamp(1.375rem, 0.57vw + 1.24rem, 1.75rem);
    line-height: 1.15;
    margin-bottom: 6px;
  }

  .points p {
    margin: 0;
    font-size: clamp(1rem, 0.1vw + 0.98rem, 1.0625rem);
    line-height: 1.55;
    color: var(--text-soft);
  }

  .more {
    grid-area: more;
    align-self: start;
  }
</style>
