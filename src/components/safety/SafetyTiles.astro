---
/**
 * Option A: two feature tiles side by side, identification and the venues as
 * equals. Each tile has its own picture over its heading and the owner's line: the
 * verified name line on Juho's photo, and three of the venues as the app lists
 * them, each with its blurb. Side by side from 48rem, stacked before that.
 */
import { type Lang, localePath, useTranslations } from '../../i18n/ui';
import Icon from '../Icon.astro';
import VerifiedCard from '../VerifiedCard.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const venues = [
  { name: 'Café Aalto', blurb: t('venue.blurb.aalto'), icon: 'coffee' },
  { name: 'Esplanadin puisto', blurb: t('venue.blurb.esplanadi'), icon: 'trees' },
  { name: 'Kaffecentralen', blurb: t('venue.blurb.kaffecentralen'), icon: 'coffee' },
];
---

<section class="slab slab-mint" aria-labelledby="safety-title">
  <div class="wrap section-pad box">
    <h2 class="display-mid" id="safety-title">{t('pitch.safety.title')}</h2>
    <div class="tiles">
      <article class="tile">
        <div class="visual id-visual">
          <VerifiedCard lang={lang} variant="photo" class="id-card" />
        </div>
        <h3>{t('safety.verified.title')}</h3>
        <p>{t('pitch.safety.verified')}</p>
      </article>
      <article class="tile">
        <div class="visual venue-visual">
          <ul class="venues" aria-hidden="true">
            {
              venues.map((v) => (
                <li>
                  <span class="pin"><Icon name="map-pin" size={18} /></span>
                  <div>
                    <b>{v.name}</b>
                    <span>{v.blurb}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
        <h3>{t('pitch.safety.venues.title')}</h3>
        <p>{t('pitch.safety.venues')}</p>
      </article>
    </div>
    <p><a class="go" href={localePath(lang, 'turvallisuus')}>{t('safety.more')}</a></p>
  </div>
</section>

<style>
  .box {
    display: grid;
    gap: clamp(20px, 1.52vw + 14px, 32px);
  }

  .tiles {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 48rem) {
    .tiles {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(16px, 1vw + 12px, 24px);
    background: var(--surface);
    border-radius: var(--radius-card);
  }

  /* The pictures stand on one height, so the two headings line up. */
  .visual {
    display: grid;
    place-items: center;
    min-height: clamp(220px, 12vw + 160px, 300px);
    margin-bottom: 10px;
    border-radius: 20px;
    overflow: hidden;
  }

  .id-visual {
    padding: 20px 16px;
    background: var(--brand-background);
  }

  .id-visual > :global(.id-card) {
    --card-width: clamp(220px, 14vw + 120px, 320px);
    transform: rotate(-2deg);
  }

  .venue-visual {
    background: var(--card-sent);
    padding: 16px;
  }

  .venues {
    list-style: none;
    margin: 0;
    padding: 0;
    width: min(100%, 22rem);
    border: 3px solid var(--ink);
    border-radius: 18px;
    background: var(--surface);
    overflow: hidden;
  }

  .venues li {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 10px 12px;
  }

  .venues li + li {
    border-top: 2px solid var(--rule);
  }

  .pin {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--brand-background);
  }

  .pin :global(svg) {
    display: block;
  }

  .venues b {
    display: block;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .venues span {
    display: block;
    font-size: 0.82rem;
    line-height: 1.3;
    color: var(--text-soft);
  }

  .tile h3 {
    font-size: clamp(1.375rem, 0.57vw + 1.24rem, 1.75rem);
    line-height: 1.15;
  }

  .tile p {
    margin: 0;
    font-size: clamp(1rem, 0.1vw + 0.98rem, 1.0625rem);
    line-height: 1.55;
    color: var(--text-soft);
  }
</style>
