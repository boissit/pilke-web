---
/**
 * The quality card: the owner's heading and line, and beside them the three
 * candidates a platter offers, as the app draws them, fanned like a hand of cards
 * with the middle one on top. Each card is a still cut out of the app
 * (`src/assets/cards.ts`), so the fan cannot drift from the real UI.
 *
 * It lays itself out by its own width rather than the page's: copy on the left and
 * the fan on the right when there is room, the fan under the copy before that.
 */
import { Image } from 'astro:assets';
import { cardsFor } from '../../assets/cards';
import { type Lang, useTranslations } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const c = cardsFor(lang);
const fan = [
  { src: c.arttu, pos: 'left' },
  { src: c.veera, pos: 'right' },
  { src: c.veeti, pos: 'middle' },
];
---

<section class="slab slab-pale quality" aria-labelledby="quality-title">
  <div class="wrap section-pad">
    <div class="inner">
      <div class="copy">
        <h2 class="display-mid" id="quality-title">{t('pitch.quality.title')}</h2>
        <p>{t('pitch.quality.body')}</p>
      </div>
      <div class="fan" role="img" aria-label={t('pitch.quality.alt')}>
        {fan.map((f) => <Image src={f.src} alt="" width={460} densities={[1, 2]} class={f.pos} loading="lazy" />)}
      </div>
    </div>
  </div>
</section>

<style>
  .quality {
    display: grid;
  }

  .quality > .wrap {
    container-type: inline-size;
  }

  .inner {
    display: grid;
    gap: clamp(28px, 2vw + 20px, 40px);
  }

  .copy {
    display: grid;
    gap: 16px;
    align-content: center;
  }

  .copy p {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(1.0625rem, 0.19vw + 1.02rem, 1.1875rem);
    line-height: 1.55;
  }

  /*
    The fan: three cards on one pivot below their feet, turned out to either side,
    the middle one last in the source so it lies on top. Flat: the cards carry their
    own ink rule, and nothing here adds a shadow.
  */
  .fan {
    --card: clamp(100px, 27cqi, 210px);
    position: relative;
    height: calc(var(--card) * 2237 / 1152 + 24px);
    justify-self: center;
    width: calc(var(--card) * 2.7);
    max-width: 100%;
  }

  .fan :global(img) {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: var(--card);
    height: auto;
    transform-origin: 50% 120%;
  }

  .fan :global(.left) {
    transform: translateX(-50%) rotate(-12deg) translateX(-46%);
  }

  .fan :global(.right) {
    transform: translateX(-50%) rotate(12deg) translateX(46%);
  }

  .fan :global(.middle) {
    transform: translateX(-50%) translateY(-14px);
  }

  @container (min-width: 44rem) {
    .inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: clamp(32px, 5vw, 96px);
    }

    .fan {
      --card: clamp(150px, 15cqi, 210px);
    }
  }
</style>
