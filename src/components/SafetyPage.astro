---
/**
 * The safety page.
 *
 * Everything the front page used to carry in three cards, plus the meeting-safely
 * advice and the location note. A page rather than a section because it is the
 * one subject here somebody arrives looking for, and because a front page that
 * spends a third of its height on safety reads as a warning about the product
 * rather than a description of it.
 *
 * WARNING: **This page states only what the app does.** It names the trusted
 * contact, the safety button and the report because those exist and ship. It
 * promises nothing about what Pilke will do on somebody's behalf, and the
 * advice below is ordinary meeting-safely sense rather than anything the product
 * enforces. Read `README.md` before adding a claim here.
 */
import '../styles/bold.css';
import { content, shots } from './variants/data';
import { localePath, type Lang } from '../i18n/ui';
import Glimmer from './Glimmer.astro';
import Phone from './Phone.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t, safety, tips } = content(lang);
---

<section class="slab slab-yellow">
  <Glimmer tile={320} background="var(--brand-main)" star="#F7E88A" />
  <div class="wrap section-pad head">
    <h1 class="display-mid">{t('safety.title')}</h1>
    <p class="lede">{t('safety.page.lead')}</p>
  </div>
</section>

<section class="slab slab-white">
  <div class="wrap section-pad tools">
    <ul class="tool-list">
      {
        safety.map((item) => (
          <li>
            <h2>{item.title}</h2>
            <p class="prose">{item.body}</p>
          </li>
        ))
      }
    </ul>
    <Phone src={shots.asetukset} alt={t('shot.asetukset')} width={260} tilt="right" />
  </div>
</section>

<section class="slab slab-pale">
  <div class="wrap section-pad">
    <h2 class="display-mid">{t('tips.title')}</h2>
    <p class="prose">{t('tips.lead')}</p>
    <ol class="tips">{tips.map((tip) => <li>{tip}</li>)}</ol>
  </div>
</section>

<section class="slab slab-white">
  <div class="wrap section-pad">
    <h2 class="display-mid">{t('privacy.title')}</h2>
    <p class="prose">{t('privacy.area')}</p>
    <p class="prose">{t('privacy.body')}</p>
    <p><a class="go" href={localePath(lang)}>{t('nav.back')}</a></p>
  </div>
</section>

<style>
  .wrap > * + * {
    margin-top: var(--pad-medium);
  }

  .head .lede {
    max-width: 42ch;
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--pad-large);
  }

  .tool-list {
    flex: 1 1 22rem;
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--pad-medium);
  }

  .tool-list > li {
    padding-bottom: var(--pad-medium);
    border-bottom: 3px solid var(--ink);
  }

  .tool-list > li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .tool-list h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    margin-bottom: var(--pad-small);
  }

  .tips {
    display: grid;
    gap: var(--pad-normal);
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    padding-left: 1.25rem;
  }

  .tips li {
    max-width: 44ch;
  }

  .go {
    display: inline-block;
    padding: 8px 18px;
    background: var(--brand-main);
    border: 3px solid var(--ink);
    border-radius: var(--radius-normal);
    font-weight: 700;
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--ink);
  }

  .go:hover {
    transform: translate(1px, 1px);
    box-shadow: 3px 3px 0 var(--ink);
  }
</style>
