---
/**
 * The whole page, in one component, taking its words from the dictionary.
 *
 * Both routes render this: Finnish at `/` and English at `/en`. Keeping the
 * structure in one file rather than two means a section cannot exist in one
 * language and not the other, which is the way a bilingual site usually drifts.
 */
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const promises = [
  { title: t('promise.one.title'), body: t('promise.one.body'), tint: 'var(--card-received)' },
  { title: t('promise.two.title'), body: t('promise.two.body'), tint: 'var(--card-sent)' },
  { title: t('promise.three.title'), body: t('promise.three.body'), tint: 'var(--card-feedback)' },
];

const steps = [
  { title: t('how.one.title'), body: t('how.one.body') },
  { title: t('how.two.title'), body: t('how.two.body') },
  { title: t('how.three.title'), body: t('how.three.body') },
  { title: t('how.four.title'), body: t('how.four.body') },
  { title: t('how.five.title'), body: t('how.five.body') },
];

const safety = [
  { title: t('safety.contact.title'), body: t('safety.contact.body') },
  { title: t('safety.button.title'), body: t('safety.button.body') },
  { title: t('safety.report.title'), body: t('safety.report.body') },
];

const tips = [
  t('tips.one'),
  t('tips.two'),
  t('tips.three'),
  t('tips.four'),
  t('tips.five'),
  t('tips.six'),
];

const faq = [
  { q: t('faq.chat.q'), a: t('faq.chat.a') },
  { q: t('faq.who.q'), a: t('faq.who.a') },
  { q: t('faq.cost.q'), a: t('faq.cost.a') },
  { q: t('faq.cancel.q'), a: t('faq.cancel.a') },
  { q: t('faq.delete.q'), a: t('faq.delete.a') },
];
---

<section class="hero">
  <div class="wrap hero-inner">
    <div class="stack hero-copy">
      <h1>{t('hero.title')}</h1>
      <p class="lead">{t('hero.lead')}</p>
      <p class="note">{t('hero.note')}</p>
    </div>
    <img class="hero-art" src="/img/rose.png" alt="" width="260" height="260" />
  </div>
</section>

<section class="band">
  <div class="wrap">
    <h2>{t('promise.title')}</h2>
    <ul class="grid three">
      {promises.map((item) => (
        <li class="card" style={`background:${item.tint}`}>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="band" id="how">
  <div class="wrap">
    <h2>{t('how.title')}</h2>
    <p class="lead">{t('how.lead')}</p>

    <!--
      An ordered list because the order is the content: these steps happen in
      this sequence and cannot be taken in another. The numbers are the list's
      own, so a screen reader counts them without help from a decoration.
    -->
    <ol class="steps">
      {steps.map((step) => (
        <li>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="band economy">
  <div class="wrap">
    <h2>{t('economy.title')}</h2>
    <p class="lead">{t('economy.lead')}</p>

    <ul class="grid two">
      <li class="card currency">
        <img src="/img/petal.png" alt="" width="64" height="64" />
        <div>
          <h3>{t('economy.petal.title')}</h3>
          <p>{t('economy.petal.body')}</p>
        </div>
      </li>
      <li class="card currency">
        <img src="/img/rose.png" alt="" width="64" height="64" />
        <div>
          <h3>{t('economy.rose.title')}</h3>
          <p>{t('economy.rose.body')}</p>
        </div>
      </li>
    </ul>

    <p class="note">{t('economy.note')}</p>
  </div>
</section>

<section class="band" id="safety">
  <div class="wrap">
    <h2>{t('safety.title')}</h2>
    <p class="lead">{t('safety.lead')}</p>

    <ul class="grid three">
      {safety.map((item) => (
        <li class="card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="band tips">
  <div class="wrap">
    <h2>{t('tips.title')}</h2>
    <p class="lead">{t('tips.lead')}</p>
    <ul class="tip-list">
      {tips.map((tip) => <li>{tip}</li>)}
    </ul>

    <div class="card privacy">
      <h3>{t('privacy.title')}</h3>
      <p>{t('privacy.body')}</p>
    </div>
  </div>
</section>

<section class="band" id="faq">
  <div class="wrap">
    <h2>{t('faq.title')}</h2>
    <dl class="faq">
      {faq.map((item) => (
        <div class="qa">
          <dt>{item.q}</dt>
          <dd>{item.a}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    background: var(--brand-background);
    border-bottom: var(--border-width) solid var(--ink);
  }

  .hero-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--pad-large);
    padding-block: clamp(var(--pad-large), 8vw, 5rem);
  }

  .hero-copy {
    flex: 1 1 22rem;
  }

  .hero-art {
    flex: 0 1 16rem;
    width: min(16rem, 55vw);
    height: auto;
  }

  .lead {
    font-size: 1.125rem;
  }

  .note {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .band {
    padding-block: var(--pad-large);
  }

  .band > .wrap > * + * {
    margin-top: var(--pad-medium);
  }

  .economy,
  .tips {
    background: var(--brand-background);
    border-block: var(--border-width) solid var(--ink);
  }

  .grid {
    display: grid;
    gap: var(--pad-medium);
    list-style: none;
    padding: 0;
  }

  .three {
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .two {
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }

  .card > * + * {
    margin-top: var(--pad-small);
  }

  .currency {
    display: flex;
    align-items: flex-start;
    gap: var(--pad-medium);
    background: var(--white);
  }

  .currency img {
    flex: 0 0 auto;
  }

  .currency > * + * {
    margin-top: 0;
  }

  .steps {
    display: grid;
    gap: var(--pad-medium);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    list-style: none;
    padding: 0;
    counter-reset: step;
  }

  .steps li {
    counter-increment: step;
    background: var(--white);
    border: var(--border-width) solid var(--ink);
    border-radius: var(--radius-large);
    padding: var(--pad-medium);
  }

  /* The number is drawn from the list counter, so it cannot disagree with the
     order of the steps themselves. */
  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: var(--pad-small);
    background: var(--brand-main);
    border: var(--border-width) solid var(--ink);
    border-radius: 50%;
    font-family: var(--font-display);
  }

  .steps p {
    margin-top: var(--pad-small);
  }

  .tip-list {
    display: grid;
    gap: var(--pad-small);
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    max-width: none;
  }

  .privacy {
    background: var(--white);
    margin-top: var(--pad-medium);
  }

  .faq {
    margin: 0;
    display: grid;
    gap: var(--pad-medium);
  }

  .qa {
    border-top: var(--border-width) solid var(--ink);
    padding-top: var(--pad-normal);
  }

  dt {
    font-weight: 800;
  }

  dd {
    margin: var(--pad-small) 0 0;
  }
</style>
