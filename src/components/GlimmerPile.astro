---
/**
 * Glimmers drawn as coins on a table, the app's own pictures.
 *
 * The same coins the app draws, from the same renderer: `pilke-app/tools/glimmer-pile`,
 * whose README is where a change to them belongs. Copied in rather than reached for
 * across repositories, because this site builds on its own.
 *
 * WARNING: **A picture of five is not five copies of a picture of one.** The coins
 * occlude each other and cast one shadow between them, so every count is its own render
 * and there is no sprite to repeat.
 *
 * The app's copies all share one camera, so that a counter's box never moves as a balance
 * changes. This site's are rendered with `--crop --trim` instead: fitted to their own
 * contents and cut to them, because each one is a fixed price in a line of text, where a
 * shared frame is only a gap the layout cannot close.
 */
import { Image } from 'astro:assets';
import five from '../assets/glimmer-pile/05.webp';

/**
 * The counts this site carries a picture of, by count.
 *
 * Imported one by one rather than globbed. A glob is tidier to read and costs the whole
 * set: Astro copies every image it can see into the build whether a page draws it or
 * not, so fourteen unused renders would ship as 700kB of the site's weight. Adding a
 * count here means copying that one file out of the app.
 */
const piles: Record<number, ImageMetadata> = { 5: five };

interface Props {
  /**
   * How tall to draw the pile, in px. The width follows from the picture.
   *
   * Height rather than width, because a trimmed pile is as wide as its coins happen to
   * be and what has to agree with the type beside it is how tall it stands.
   */
  height: number;
  /**
   * How many glimmers to draw.
   *
   * A number of glimmers rather than a balance: every use on this site is a price or an
   * amount earned, not somebody's counter.
   */
  glimmers: number;
  alt: string;
  class?: string;
}

const { height, glimmers, alt, class: className } = Astro.props;

const pile = piles[glimmers];

if (!pile) {
  throw new Error(
    `GlimmerPile: this site carries no picture of ${glimmers} glimmers, only ` +
      `${Object.keys(piles).join(', ')}. The app has renders of 1 to 15 in ` +
      'assets/images/glimmer-pile; copy the one wanted in beside this component and add ' +
      'it to the table above.',
  );
}
---

<!--
  Thrown rather than clamped, unlike the app's copy of this. The app clamps because a
  balance is live and a refund can carry it past the ceiling with nobody able to stop it;
  every count on this site is written into the page by hand, so a count with no picture
  is a typo and should fail the build rather than quietly draw a different amount.
-->
<Image src={pile} alt={alt} height={height} densities={[1, 2]} loading="lazy" class={className} />
