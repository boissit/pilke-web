---
/**
 * The wordmark: the letters and their rose sparkle, the owner's release
 * artwork drawn as it is (`src/assets/brand/`), the same drawing the app draws in its
 * Treffit bar (`pilke-app/src/components/svgs/Wordmark.tsx`).
 *
 * Inlined rather than linked, so it is drawn with the page and never flashes in, and
 * sized by its **height**: the lockup is wider than tall, and the artwork's own
 * viewBox owns the other side. `tone="white"` is the variant for dark grounds.
 *
 * Decorative here: every place that draws it is a link that names itself (*Pilke,
 * etusivu*), so the drawing takes `aria-hidden` rather than a second name. Pass
 * `label` where the wordmark stands alone.
 */
import ink from '../assets/brand/pilke-wordmark.svg?raw';
import white from '../assets/brand/pilke-wordmark-white.svg?raw';

interface Props {
  /** The wordmark's height in px. The width follows the artwork's aspect. */
  height: number;
  tone?: 'ink' | 'white';
  label?: string;
  class?: string;
}

const { height, tone = 'ink', label, class: className } = Astro.props;

const source = tone === 'white' ? white : ink;
const viewBox = source.match(/viewBox="([^"]+)"/)?.[1];
const body = source.match(/<svg[^>]*>([\s\S]*)<\/svg>/)?.[1]?.replace(/<title>[\s\S]*?<\/title>/, '').trim();
if (!viewBox || !body) throw new Error('Logo: the wordmark artwork has no viewBox or no paths.');

const [, , w, h] = viewBox.split(/\s+/).map(Number);
const width = Math.round(((height * w) / h) * 100) / 100;
---

<svg
  class:list={['logo', className]}
  width={width}
  height={height}
  viewBox={viewBox}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>

<style>
  /* Block, so the mark takes no descender space under it. A caller that scales it
     with the viewport sets `height` on its class and `width: auto`. */
  .logo {
    display: block;
  }
</style>
