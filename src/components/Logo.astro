---
/**
 * The wordmark, drawn from the same numbers the app draws it from.
 *
 * A port of `pilke-app/src/components/Logo.tsx`, and the two constants below are that
 * file's rather than new ones. It composes the word in Courgette with the rose beside
 * it, and everything scales with the font size, so the header mark and a hero mark are
 * the same drawing at two sizes rather than two drawings.
 *
 * Not an SVG of the whole lockup: the word is live text in Courgette, which the site
 * already loads. Converting it to paths would give a second copy of the wordmark to
 * keep in step with the app, and would stop the mark being selectable or readable.
 */
import RoseMark from './RoseMark.astro';

/**
 * The mark's **height**, as a multiple of the word's font size.
 *
 * A height rather than a width because a height is the one dimension `RoseMark` takes:
 * the rose is not square and `ROSE_ASPECT` owns the other side. At the header's 30 that
 * is 32 tall by 23 across.
 */
const MARK_HEIGHT = 1.05;

/**
 * The gap between the word and the mark, as a multiple of the font size.
 *
 * ⚠️ **A real gap, and the mark may not overlap the type.** A filled rose pulled over
 * the final *e* covers the *e*. So the mark is a sibling of the word laid out in flow
 * with this between them, and nothing in this file positions one against the other.
 */
const MARK_GAP = 0.18;

interface Props {
  /** Font size of the word. The mark and the gap are derived, as in the app. */
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<span
  class:list={['logo', className]}
  style={`--size:${size}px; --gap:${MARK_GAP * size}px;`}
>
  <span class="word">Pilke</span>
  <RoseMark size={MARK_HEIGHT * size} />
</span>

<style>
  /*
    One row: the word, a gap, the mark, bottom-aligned so the rose's stem finishes where
    the letters do. Not centred: the mark is a plant with a stem, and centring it
    against the line box leaves the stem ending in mid air with the drawing floating off
    its own ground.
  */
  .logo {
    display: inline-flex;
    align-items: flex-end;
    column-gap: var(--gap);
  }

  .word {
    font-family: var(--font-display);
    font-size: var(--size);
    line-height: 1;
    color: var(--ink);
    /* Courgette's own side bearing is enough; a letter-spacing here would be a
       departure from the app, which sets none. */
    letter-spacing: 0;
  }
</style>
